<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BiliSubStudio.Core.ContractTests</RootNamespace>
    <AssemblyName>BiliSubStudio.Core.ContractTests</AssemblyName>
    <!-- Suite chạy trên Windows (như app win-x64): tắt cảnh báo platform cho
         test GDI+ (đã guard OperatingSystem.IsWindows + SupportedOSPlatform). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\..\internal\ocr\worker.py" Link="Assets\worker.py" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\BiliSubStudio.Core\BiliSubStudio.Core.csproj" />
    <!-- Builds the fake Chromium/Firefox cookie stores the browser-session import test reads. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <Content Include="..\..\..\internal\translation\dich-trung-tu-tien.zip" Link="Fixtures\dich-trung-tu-tien.zip" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\internal\vieneu\worker.py" Link="Fixtures\vieneu-worker.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\internal\asr\worker.py" Link="Assets\ASR\worker.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
