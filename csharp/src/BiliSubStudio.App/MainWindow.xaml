<Window
    x:Class="BiliSubStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="0"
            AlwaysShowHeader="False"
            Background="{ThemeResource CanvasBrush}"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            OpenPaneLength="216"
            PaneDisplayMode="Left"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Tải media" Tag="video" />
                <NavigationViewItem Content="OCR phụ đề" Tag="ocr" />
                <NavigationViewItem Content="Chỉnh video" Tag="editor" />
                <NavigationViewItem Content="Cài đặt" Tag="settings" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Background="{ThemeResource CanvasBrush}" />
        </NavigationView>

        <Border
            x:Name="GlobalLogPanel"
            Grid.Row="1"
            Height="276"
            Visibility="Collapsed"
            Background="{ThemeResource TopbarBrush}"
            BorderBrush="{ThemeResource StrongBorderBrush}"
            BorderThickness="0,1,0,1">
            <Grid Padding="16,12" RowSpacing="9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Text="Nhật ký toàn ứng dụng" />
                            <Border Padding="8,3" Background="{ThemeResource SuccessSoftBrush}" BorderBrush="{ThemeResource SuccessBrush}" BorderThickness="1" CornerRadius="10">
                                <TextBlock FontSize="10" Foreground="{ThemeResource SuccessBrush}" Text="Bình thường" />
                            </Border>
                            <Border Padding="8,3" Background="{ThemeResource WarningSoftBrush}" BorderBrush="{ThemeResource WarningBrush}" BorderThickness="1" CornerRadius="10">
                                <TextBlock FontSize="10" Foreground="{ThemeResource WarningBrush}" Text="Cảnh báo" />
                            </Border>
                            <Border Padding="8,3" Background="{ThemeResource DangerSoftBrush}" BorderBrush="{ThemeResource DangerBrush}" BorderThickness="1" CornerRadius="10">
                                <TextBlock FontSize="10" Foreground="{ThemeResource DangerBrush}" Text="Lỗi" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="LogFileText" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="OpenLogFile_Click" Content="Mở file log" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Click="ClearLogView_Click" Content="Xóa màn hình" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Click="CollapseLog_Click" Content="Thu gọn" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Border
                    x:Name="GlobalJobProgressPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Padding="10,8"
                    Background="{ThemeResource RaisedSurfaceBrush}"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
                    <Grid RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GlobalJobProgressTitle" FontSize="11" FontWeight="SemiBold" Text="Vietsub AI local" />
                            <TextBlock x:Name="GlobalJobProgressPercent" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Text="0%" />
                        </Grid>
                        <ProgressBar x:Name="GlobalJobProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="GlobalJobProgressText" Grid.Row="2" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" MaxLines="3" />
                    </Grid>
                </Border>

                <ListView
                    x:Name="GlobalLogList"
                    Grid.Row="2"
                    ItemsSource="{x:Bind GlobalLogEntries, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    AutomationProperties.Name="Nhật ký toàn ứng dụng">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,2" ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="94" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Top" FontFamily="Cascadia Mono" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" Text="{Binding Time}" />
                                <Grid Grid.Column="1">
                                    <Border Visibility="{Binding InfoVisibility}" Padding="7,2" Background="{ThemeResource SuccessSoftBrush}" CornerRadius="7">
                                        <TextBlock FontSize="10" Foreground="{ThemeResource SuccessBrush}" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Border Visibility="{Binding WarningVisibility}" Padding="7,2" Background="{ThemeResource WarningSoftBrush}" CornerRadius="7">
                                        <TextBlock FontSize="10" Foreground="{ThemeResource WarningBrush}" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Border Visibility="{Binding ErrorVisibility}" Padding="7,2" Background="{ThemeResource DangerSoftBrush}" CornerRadius="7">
                                        <TextBlock FontSize="10" Foreground="{ThemeResource DangerBrush}" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <TextBlock Visibility="{Binding InfoVisibility}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{ThemeResource SuccessBrush}" Text="{Binding Message}" TextWrapping="Wrap" />
                                    <TextBlock Visibility="{Binding WarningVisibility}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{ThemeResource WarningBrush}" Text="{Binding Message}" TextWrapping="Wrap" />
                                    <TextBlock Visibility="{Binding ErrorVisibility}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{ThemeResource DangerBrush}" Text="{Binding Message}" TextWrapping="Wrap" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{ThemeResource TopbarBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="12,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="GlobalLogToggle"
                    Padding="10,3"
                    MinHeight="28"
                    VerticalAlignment="Center"
                    Click="GlobalLogToggle_Click"
                    Content="Nhật ký toàn ứng dụng"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <TextBlock
                    x:Name="FooterStatus"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{ThemeResource MutedTextBrush}"
                    Text="Đang khởi tạo ứng dụng..."
                    TextTrimming="CharacterEllipsis" />
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Border x:Name="LogHealthyCountBorder" Padding="8,3" Background="{ThemeResource SuccessSoftBrush}" CornerRadius="10">
                        <TextBlock FontSize="10" Foreground="{ThemeResource SuccessBrush}" Text="0 lỗi" />
                    </Border>
                    <Border x:Name="LogErrorCountBorder" Padding="8,3" Background="{ThemeResource DangerSoftBrush}" CornerRadius="10" Visibility="Collapsed">
                        <TextBlock x:Name="LogErrorCount" FontSize="10" Foreground="{ThemeResource DangerBrush}" Text="0 lỗi" />
                    </Border>
                </Grid>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" Text="{x:Bind PublicVersionLabel, Mode=OneTime}" />
            </Grid>
        </Border>
    </Grid>
</Window>