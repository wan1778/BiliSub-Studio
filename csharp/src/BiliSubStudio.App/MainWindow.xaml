<Window
    x:Class="BiliSubStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource CanvasBrush}" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="0"
            AlwaysShowHeader="False"
            Background="{ThemeResource CanvasBrush}"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="216"
            PaneDisplayMode="Left"
            AutomationProperties.Name="Điều hướng chính"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.PaneHeader>
                <Grid Height="64" Padding="16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="{ThemeResource AccentPrimaryBrush}" CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" Text="B" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Text="BiliSub Studio" />
                        <TextBlock FontSize="10" Foreground="{ThemeResource MutedTextBrush}" Text="C# · WinUI 3 migration" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem AccessKey="P" Content="Phụ đề" Tag="subtitle" ToolTipService.ToolTip="Phụ đề Bilibili">
                    <NavigationViewItem.Icon><PathIcon Data="M2,3 L18,3 L18,15 L2,15 Z M5,7 L15,7 M5,11 L12,11" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AccessKey="V" Content="Tải video" Tag="video" ToolTipService.ToolTip="Tải video Bilibili">
                    <NavigationViewItem.Icon><PathIcon Data="M2,3 L18,3 L18,15 L2,15 Z M8,6 L14,9 L8,12 Z" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AccessKey="O" Content="OCR phụ đề" Tag="ocr" ToolTipService.ToolTip="OCR phụ đề cứng">
                    <NavigationViewItem.Icon><PathIcon Data="M2,6 L2,2 L6,2 M14,2 L18,2 L18,6 M18,12 L18,16 L14,16 M6,16 L2,16 L2,12 M6,7 L14,7 M6,11 L12,11" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AccessKey="E" Content="Chỉnh video" Tag="editor" ToolTipService.ToolTip="Chỉnh video">
                    <NavigationViewItem.Icon><PathIcon Data="M3,3 L17,3 L17,15 L3,15 Z M6,6 L14,6 L14,12 L6,12 Z" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AccessKey="H" Content="Hiệu năng" Tag="hardware" ToolTipService.ToolTip="Phần cứng và benchmark">
                    <NavigationViewItem.Icon><PathIcon Data="M3,5 L17,5 L17,14 L3,14 Z M6,8 L9,8 L9,11 L6,11 Z M12,8 L15,8" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem AccessKey="A" Content="Đăng nhập" Tag="account" ToolTipService.ToolTip="Tài khoản Bilibili">
                    <NavigationViewItem.Icon><PathIcon Data="M10,2 A4,4 0 1 0 10,10 A4,4 0 1 0 10,2 M3,18 C3,13 17,13 17,18" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AccessKey="U" Content="Cập nhật &amp; hỗ trợ" Tag="support" ToolTipService.ToolTip="Cập nhật và gửi báo lỗi">
                    <NavigationViewItem.Icon><PathIcon Data="M10,2 A8,8 0 1 0 18,10 M10,6 L10,11 L14,11 M10,14 L10,15" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" AccessKey="S" Content="Cài đặt" Tag="settings" ToolTipService.ToolTip="Cài đặt ứng dụng">
                    <NavigationViewItem.Icon><PathIcon Data="M10,2 L12,4 L15,4 L16,7 L18,9 L16,11 L15,14 L12,14 L10,16 L8,14 L5,14 L4,11 L2,9 L4,7 L5,4 L8,4 Z M10,7 A2,2 0 1 0 10,11 A2,2 0 1 0 10,7" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Background="{ThemeResource CanvasBrush}" />
        </NavigationView>

        <Border Grid.Row="1" Background="{ThemeResource TopbarBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}" Text="Nhật ký kỹ thuật" />
                <TextBlock
                    x:Name="FooterStatus"
                    Grid.Column="1"
                    Margin="24,0"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="10"
                    Foreground="{ThemeResource MutedTextBrush}"
                    Text="Đang khởi tạo C# application boundary..."
                    TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" Text="baseline 9be4abd" />
            </Grid>
        </Border>
    </Grid>
</Window>
