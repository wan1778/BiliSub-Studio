<Window
    x:Class="BiliSubStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource CanvasBrush}" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="0"
            AlwaysShowHeader="False"
            Background="{ThemeResource CanvasBrush}"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="216"
            PaneDisplayMode="Left"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Phụ đề" Tag="subtitle" />
                <NavigationViewItem Content="Tải video" Tag="video" />
                <NavigationViewItem Content="OCR phụ đề" Tag="ocr" />
                <NavigationViewItem Content="Chỉnh video" Tag="editor" />
                <NavigationViewItem Content="Hiệu năng" Tag="hardware" />
                <NavigationViewItem Content="Đăng nhập" Tag="account" />
                <NavigationViewItem Content="Cập nhật &amp; hỗ trợ" Tag="support" />
                <NavigationViewItem Content="Cài đặt" Tag="settings" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Background="{ThemeResource CanvasBrush}" />
        </NavigationView>

        <Border Grid.Row="1" Background="{ThemeResource TopbarBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}" Text="Nhật ký kỹ thuật" />
                <TextBlock
                    x:Name="FooterStatus"
                    Grid.Column="1"
                    Margin="24,0"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{ThemeResource MutedTextBrush}"
                    Text="Đang khởi tạo ứng dụng..."
                    TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" Text="C# · .NET 10 · WinUI 3" />
            </Grid>
        </Border>
    </Grid>
</Window>
