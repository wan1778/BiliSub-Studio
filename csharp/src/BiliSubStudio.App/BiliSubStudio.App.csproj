<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BiliSubStudio.App</RootNamespace>
    <AssemblyName>BiliSubStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BiliSubStudio.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en-US;vi-VN</SatelliteResourceLanguages>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BiliSubStudio.Core\BiliSubStudio.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\internal\ocr\worker.py" Link="Assets\worker.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\internal\asr\worker.py" Link="Assets\ASR\worker.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\internal\tts\worker.py" Link="Assets\TTS\worker.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\internal\translation\dich-trung-tu-tien.zip" Link="Assets\Translation\dich-trung-tu-tien.zip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyCompiledXamlResourcesToPublish" AfterTargets="Publish" Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <_CompiledXamlResource Include="$(OutputPath)**\*.xbf" />
      <_CompiledXamlResource Include="$(OutputPath)$(AssemblyName).pri" Condition="Exists('$(OutputPath)$(AssemblyName).pri')" />
      <_CompiledXamlResource Include="$(OutputPath)resources.pri" Condition="Exists('$(OutputPath)resources.pri')" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_CompiledXamlResource)"
      DestinationFiles="@(_CompiledXamlResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
