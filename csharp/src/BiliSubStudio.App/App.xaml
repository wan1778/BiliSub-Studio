<Application
    x:Class="BiliSubStudio.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#090E14" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#0D141D" />
                    <SolidColorBrush x:Key="TopbarBrush" Color="#0C121B" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#111A25" />
                    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#151F2C" />
                    <SolidColorBrush x:Key="StrongSurfaceBrush" Color="#1A2635" />
                    <SolidColorBrush x:Key="InputSurfaceBrush" Color="#0C141E" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#273548" />
                    <SolidColorBrush x:Key="StrongBorderBrush" Color="#35495F" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F7FC" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B8C5D3" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#7E8EA3" />
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="#65768C" />
                    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#318EF2" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#173552" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#42CC96" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#123A2D" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#F2B658" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3B2C13" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF6F80" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3E1C24" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#F6F8FC" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#EEF3F8" />
                    <SolidColorBrush x:Key="TopbarBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#EDF3FA" />
                    <SolidColorBrush x:Key="StrongSurfaceBrush" Color="#E2EBF5" />
                    <SolidColorBrush x:Key="InputSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#D2DCE8" />
                    <SolidColorBrush x:Key="StrongBorderBrush" Color="#AEBFD1" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#142033" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#425269" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#6C7C90" />
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="#95A2B2" />
                    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#2F83E4" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCEEFF" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#147A55" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E5F7EF" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#9A6400" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF4D8" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C8344A" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFE8EC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#090E14" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#0D141D" />
                    <SolidColorBrush x:Key="TopbarBrush" Color="#0C121B" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#111A25" />
                    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#151F2C" />
                    <SolidColorBrush x:Key="StrongSurfaceBrush" Color="#1A2635" />
                    <SolidColorBrush x:Key="InputSurfaceBrush" Color="#0C141E" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#273548" />
                    <SolidColorBrush x:Key="StrongBorderBrush" Color="#35495F" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F7FC" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B8C5D3" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#7E8EA3" />
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="#65768C" />
                    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#318EF2" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#173552" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#42CC96" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#123A2D" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#F2B658" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3B2C13" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF6F80" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3E1C24" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="Background" Value="{ThemeResource RaisedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource StrongBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource DangerSoftBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DangerBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource DangerBrush}" />
            </Style>
            <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Background" Value="{ThemeResource InputSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
