<Page
    x:Class="BiliSubStudio.App.Pages.VideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Tải media Bilibili">
    <ScrollViewer>
        <Grid x:Name="PageRoot" Padding="28" MaxWidth="1180" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Tải media"/>
                <TextBlock
                    MaxWidth="860"
                    TextWrapping="Wrap"
                    Style="{StaticResource BodyTextStyle}"
                    Text="Dán liên kết Bilibili, kiểm tra nguồn rồi chọn nơi lưu. Mặc định app tải Video + Thumbnail + Phụ đề nếu nguồn có."/>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,22,0,0" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="1. Nguồn Bilibili"/>
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Dán link rồi bấm Kiểm tra để đọc chất lượng, thumbnail và phụ đề."/>
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="UrlBox"
                            Style="{StaticResource InputTextBoxStyle}"
                            PlaceholderText="https://www.bilibili.com/video/..."
                            TextChanged="UrlBox_TextChanged"/>
                        <Button
                            x:Name="LoadMetadataButton"
                            Grid.Column="1"
                            MinWidth="104"
                            AccessKey="I"
                            Click="LoadMetadata_Click"
                            Content="Kiểm tra"/>
                    </Grid>
                    <TextBlock
                        x:Name="MetadataText"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Chưa kiểm tra nguồn."/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="2. Nội dung cần tải"/>
                        <TextBlock
                            TextWrapping="Wrap"
                            Style="{StaticResource MutedTextStyle}"
                            Text="Không chọn mục nào = tải đủ cả 3. Chọn một hoặc nhiều mục bên dưới = chỉ tải đúng các mục đã chọn."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="28">
                        <CheckBox x:Name="VideoAssetCheckBox" Content="Video"/>
                        <CheckBox x:Name="ThumbnailAssetCheckBox" Content="Thumbnail"/>
                        <CheckBox x:Name="SubtitleAssetCheckBox" Content="Phụ đề"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="3. Chất lượng và định dạng"/>
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Best ưu tiên chất lượng cao nhất mà nguồn/tài khoản hiện tại cho phép."/>
                    </StackPanel>

                    <Grid ColumnSpacing="18" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="5">
                            <TextBlock FontWeight="SemiBold" Text="Chất lượng video"/>
                            <ComboBox x:Name="QualityBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock FontWeight="SemiBold" Text="Nội dung video"/>
                            <ComboBox x:Name="ModeBox" SelectedIndex="0">
                                <x:String>video+audio</x:String>
                                <x:String>video-only</x:String>
                                <x:String>audio-only</x:String>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="5">
                            <TextBlock FontWeight="SemiBold" Text="Tốc độ tải"/>
                            <ComboBox x:Name="SpeedBox" SelectedIndex="1">
                                <x:String>stable</x:String>
                                <x:String>fast</x:String>
                                <x:String>turbo</x:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                            <TextBlock FontWeight="SemiBold" Text="Định dạng video"/>
                            <ComboBox x:Name="ContainerBox" SelectedIndex="0">
                                <x:String>mp4</x:String>
                                <x:String>mkv</x:String>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="5">
                            <TextBlock FontWeight="SemiBold" Text="Track phụ đề (nếu có)"/>
                            <ComboBox x:Name="TrackBox" DisplayMemberPath="DisplayName"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5">
                            <TextBlock FontWeight="SemiBold" Text="Định dạng phụ đề"/>
                            <ComboBox x:Name="FormatBox" SelectedIndex="0">
                                <x:String>srt</x:String>
                                <x:String>txt</x:String>
                                <x:String>json</x:String>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="4. Nơi lưu và bắt đầu"/>
                        <TextBlock
                            TextWrapping="Wrap"
                            Style="{StaticResource MutedTextStyle}"
                            Text="Bạn phải chọn nơi lưu. File tạm/resume của video dài cũng nằm trên ổ này để không làm đầy ổ cài app."/>
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="OutputPathBox"
                            Style="{StaticResource InputTextBoxStyle}"
                            IsReadOnly="True"
                            PlaceholderText="Chưa chọn thư mục lưu"/>
                        <Button
                            x:Name="ChooseOutputButton"
                            Grid.Column="1"
                            MinWidth="132"
                            Click="Start_Click"
                            Content="Chọn thư mục…"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="StartButton"
                            MinWidth="130"
                            Click="Start_Click"
                            Content="Tải media"
                            IsEnabled="False"/>
                        <Button
                            x:Name="CancelButton"
                            Click="Cancel_Click"
                            Content="Hủy"
                            IsEnabled="False"
                            Style="{StaticResource DangerButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Tiến độ"/>
                    <Grid>
                        <ProgressBar
                            x:Name="Progress"
                            Height="8"
                            Minimum="0"
                            Maximum="100"
                            AutomationProperties.Name="Tiến độ tải media"/>
                        <TextBlock
                            x:Name="PercentText"
                            HorizontalAlignment="Right"
                            Margin="0,-22,0,0"
                            Style="{StaticResource MutedTextStyle}"/>
                    </Grid>
                    <TextBlock
                        x:Name="StatusText"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Sẵn sàng."
                        AutomationProperties.LiveSetting="Polite"/>
                    <TextBox
                        x:Name="LogBox"
                        Height="150"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontFamily="Cascadia Mono"
                        AutomationProperties.Name="Nhật ký tải media"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
