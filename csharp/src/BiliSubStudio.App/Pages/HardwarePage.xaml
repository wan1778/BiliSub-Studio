<Page
    x:Class="BiliSubStudio.App.Pages.HardwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource CanvasBrush}"
    AutomationProperties.Name="Phần cứng và benchmark">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageRoot" Padding="0,0,0,28" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HardwareGrid" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Máy hiện tại" />
                            <Border HorizontalAlignment="Right" Padding="9,4" Background="{ThemeResource SuccessSoftBrush}" CornerRadius="10">
                                <TextBlock FontSize="10" Foreground="{ThemeResource SuccessBrush}" Text="Native probe" />
                            </Border>
                        </Grid>
                        <Border Padding="12,10" Background="{ThemeResource RaisedSurfaceBrush}" CornerRadius="9">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="CpuText" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock x:Name="MemoryText" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock x:Name="GpuText" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="RefreshButton" HorizontalAlignment="Left" Click="Refresh_Click" Content="Probe lại" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ToolsCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Công cụ portable" />
                            <Border HorizontalAlignment="Right" Padding="9,4" Background="{ThemeResource AccentSoftBrush}" CornerRadius="10">
                                <TextBlock FontSize="10" Foreground="{ThemeResource AccentPrimaryBrush}" Text="App-owned" />
                            </Border>
                        </Grid>
                        <Border Padding="12,10" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="9">
                            <TextBlock x:Name="ToolsText" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource AccentPrimaryBrush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="PrepareToolsButton" Click="PrepareTools_Click" Content="Chuẩn bị FFmpeg + yt-dlp" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="PrepareOcrButton" Click="PrepareOcr_Click" Content="Chuẩn bị OCR" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Benchmark an toàn" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Đo CPU/RAM để đưa tín hiệu cho OCR Auto; không tự ý nâng lane trước probe video thật." />
                            </StackPanel>
                            <Button x:Name="BenchmarkButton" HorizontalAlignment="Right" Click="Benchmark_Click" Content="Chạy benchmark" />
                        </Grid>
                        <ProgressBar x:Name="Progress" IsIndeterminate="False" AutomationProperties.Name="Tiến độ chuẩn bị hoặc benchmark" />
                        <Border Padding="12,10" Background="{ThemeResource SuccessSoftBrush}" BorderBrush="{ThemeResource SuccessBrush}" BorderThickness="1" CornerRadius="9">
                            <TextBlock x:Name="ResultText" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource SuccessBrush}" Text="Chưa chạy." AutomationProperties.LiveSetting="Polite" />
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Padding="14" Background="{ThemeResource WarningSoftBrush}" BorderBrush="{ThemeResource WarningBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource WarningBrush}" Text="Quy tắc OCR Auto" />
                            <TextBlock FontSize="11" Foreground="{ThemeResource WarningBrush}" TextWrapping="Wrap" Text="Benchmark chỉ là tín hiệu. Auto thử mốc 1 → 2 → 4 → 8 → 16; nếu mốc cao không đạt, nó quay về mức PASS rồi thử các mức giữa trước khi khóa topology." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
