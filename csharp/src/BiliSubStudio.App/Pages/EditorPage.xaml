<Page
    x:Class="BiliSubStudio.App.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource CanvasBrush}"
    AutomationProperties.Name="Chỉnh video"
    IsTabStop="True"
    KeyDown="Page_KeyDown">
    <Grid Padding="12,10,12,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock FontSize="10" Foreground="{ThemeResource MutedTextBrush}" Text="BiliSub Studio / Chỉnh video" />
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Chỉnh video" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Padding="8,3" Background="{ThemeResource AccentSoftBrush}" CornerRadius="9">
                    <TextBlock FontSize="10" Foreground="{ThemeResource AccentPrimaryBrush}" Text="Project tự lưu" />
                </Border>
                <Border Padding="8,3" Background="{ThemeResource SuccessSoftBrush}" CornerRadius="9">
                    <TextBlock FontSize="10" Foreground="{ThemeResource SuccessBrush}" Text="Không ghi đè nguồn" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SourceColumn" Width="0.68*" MinWidth="120" MaxWidth="200" />
                <ColumnDefinition x:Name="PlayerColumn" Width="2.2*" MinWidth="220" />
                <ColumnDefinition x:Name="DetailsColumn" Width="1.22*" MinWidth="320" MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="10" Background="{ThemeResource RaisedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="Source" />
                        <Button Grid.Column="1" x:Name="OpenVideoButton" AccessKey="O" Click="OpenVideo_Click" Content="Mở video" Padding="9,5" Visibility="Collapsed" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Video" />
                                <TextBlock x:Name="PathText" Style="{StaticResource MutedTextStyle}" Text="Chưa chọn video." TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource BorderBrush}" />
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="SRT" />
                                <TextBlock x:Name="SrtPathText" Style="{StaticResource MutedTextStyle}" Text="Chưa chọn SRT." TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource BorderBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="Ảnh / logo" />
                                <ListView x:Name="ImageSourceList" MinHeight="74" MaxHeight="130" AutomationProperties.Name="Danh sách ảnh và logo nguồn" />
                                <TextBlock FontSize="10" Foreground="{ThemeResource SecondaryTextBrush}" Text="Tối đa 8 ảnh. Chỉnh vị trí ở tool Ảnh/Logo." TextWrapping="Wrap" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource BorderBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="Project" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Tự lưu thay đổi · source media luôn giữ nguyên." TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="EditorAutoCompositeToggle" Header="Tự cập nhật preview" IsOn="True" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="PreviewSurface" Background="Black" BorderBrush="{ThemeResource StrongBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid AutomationProperties.Name="Player Editor">
                        <MediaPlayerElement x:Name="PreviewPlayer" AreTransportControlsEnabled="False" AutoPlay="False" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Video preview" />
                        <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Frame preview" />
                        <Canvas x:Name="Overlay" Background="Transparent" IsHitTestVisible="False"
                                PointerPressed="Overlay_PointerPressed" PointerMoved="Overlay_PointerMoved"
                                PointerReleased="Overlay_PointerReleased" PointerCanceled="Overlay_PointerCanceled"
                                AutomationProperties.Name="Vùng chỉnh trực tiếp" />
                        <Canvas x:Name="ImageOverlayCanvas" Background="Transparent" IsHitTestVisible="False" AutomationProperties.Name="Ảnh và logo trên preview" />
                        <Border x:Name="EmptyPreviewState" Background="#CC0B1220" CornerRadius="12" Visibility="Visible" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Padding="16">
                                <Border Background="{ThemeResource RaisedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                                        <Border Width="56" Height="56" CornerRadius="14" Background="{ThemeResource AccentSoftBrush}" HorizontalAlignment="Center" BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1">
                                            <FontIcon Glyph="&#xE8B2;" FontSize="26" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock Text="Chưa có video" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Chọn video để thêm SRT Việt, tạo voice và xem preview." FontSize="11" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <Button x:Name="EmptyOpenVideoButton" Click="OpenVideo_Click" Content="📁  Mở video" HorizontalAlignment="Stretch" MinHeight="40" CornerRadius="8" FontWeight="SemiBold" Background="{ThemeResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0"/>
                                        <TextBlock Text="Hỗ trợ MP4 · MKV · MOV · kéo thả" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Center" Opacity="0.85"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" x:Name="PlayerControlBar" Height="48" Padding="8,5" Background="{ThemeResource RaisedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="9" AutomationProperties.Name="Điều khiển preview">
                    <Grid ColumnSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayerPlayPauseButton" Click="PlayerPlayPause_Click" Content="▶" IsEnabled="False" Padding="0" HorizontalContentAlignment="Center" ToolTipService.ToolTip="Phát / tạm dừng preview" />
                        <TextBlock Grid.Column="1" x:Name="ClockText" VerticalAlignment="Center" FontSize="11" Text="00:00 / 00:00" />
                        <Slider Grid.Column="2" x:Name="Timeline" Minimum="0" IsEnabled="False" ValueChanged="Timeline_ValueChanged" VerticalAlignment="Center" AutomationProperties.Name="Vị trí video" />
                        <ToggleSwitch Grid.Column="3" x:Name="PreviewMuteToggle" Toggled="PreviewMute_Toggled" OffContent="" OnContent="" MinWidth="0" HorizontalAlignment="Center" ToolTipService.ToolTip="Tắt / bật tiếng" />
                        <Slider Grid.Column="4" x:Name="PreviewVolumeSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="PreviewVolume_ValueChanged" VerticalAlignment="Center" AutomationProperties.Name="Âm lượng preview" />
                        <Button Grid.Column="5" x:Name="FullscreenButton" AccessKey="F" Click="Fullscreen_Click" Content="⛶" IsEnabled="False" Padding="0" HorizontalContentAlignment="Center" ToolTipService.ToolTip="Toàn màn hình" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Padding="9" Background="{ThemeResource RaisedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="#0F1724" BorderBrush="#2A3A52" BorderThickness="1" CornerRadius="16" Padding="6" VerticalAlignment="Center">
                        <Grid Height="68" VerticalAlignment="Center">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#1B2F4A"/>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#234060"/>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#1A2D4D"/>
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#5AB0FF"/>
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#6AB8FF"/>
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#4A9CE6"/>
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#2A4A6B"/>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="CornerRadius" Value="14"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#8A97B0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <!-- uniform height separators, vertically centered -->
                            <Rectangle Grid.Column="1" Width="1" Height="36" Fill="#1E2D44" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Width="1" Height="36" Fill="#1E2D44" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="3" Width="1" Height="36" Fill="#1E2D44" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="4" Width="1" Height="36" Fill="#1E2D44" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="5" Width="1" Height="36" Fill="#1E2D44" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="SubtitleModeButton" Grid.Column="0" Tag="Subtitle" IsChecked="True" ToolTipService.ToolTip="Văn bản">
                                <Grid Width="56" VerticalAlignment="Center">
                                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="14"/></Grid.RowDefinitions>
                                    <Grid Height="28" VerticalAlignment="Center"><FontIcon Glyph="&#xE8F2;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                    <TextBlock Grid.Row="1" Text="VĂN BẢN" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="14" TextAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="BlurModeButton" Grid.Column="1" Tag="Blur" ToolTipService.ToolTip="Blur">
                                <Grid Width="56" VerticalAlignment="Center">
                                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="14"/></Grid.RowDefinitions>
                                    <Grid Height="28" VerticalAlignment="Center"><FontIcon Glyph="&#xE7B3;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                    <TextBlock Grid.Row="1" Text="BLUR" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="14" TextAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="AudioModeButton" Grid.Column="2" Tag="Audio" ToolTipService.ToolTip="Âm nhạc">
                                <Grid Width="56" VerticalAlignment="Center">
                                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="14"/></Grid.RowDefinitions>
                                    <Grid Height="28" VerticalAlignment="Center"><FontIcon Glyph="&#xE8D6;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                    <TextBlock Grid.Row="1" Text="ÂM NHẠC" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="14" TextAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="VoiceModeButton" Grid.Column="3" Tag="Voice" ToolTipService.ToolTip="Giọng nói">
                                <Grid Width="56" VerticalAlignment="Center">
                                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="14"/></Grid.RowDefinitions>
                                    <Grid Height="28" VerticalAlignment="Center"><FontIcon Glyph="&#xE720;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                    <TextBlock Grid.Row="1" Text="GIỌNG NÓI" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="14" TextAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="ImageModeButton" Grid.Column="4" Tag="Image" ToolTipService.ToolTip="Hình ảnh">
                                <Grid Width="56" VerticalAlignment="Center">
                                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="14"/></Grid.RowDefinitions>
                                    <Grid Height="28" VerticalAlignment="Center"><FontIcon Glyph="&#xEB9F;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                    <TextBlock Grid.Row="1" Text="HÌNH ẢNH" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="14" TextAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="ExportModeButton" Grid.Column="5" Tag="Export" ToolTipService.ToolTip="Xuất">
                                <Grid Width="56" VerticalAlignment="Center">
                                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="14"/></Grid.RowDefinitions>
                                    <Grid Height="28" VerticalAlignment="Center"><FontIcon Glyph="&#xEDE1;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                    <TextBlock Grid.Row="1" Text="XUẤT" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="14" TextAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel x:Name="SubtitleInspectorPanel" Spacing="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE8BD;" FontSize="15" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Phụ đề tiếng Việt" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Dùng SRT đã dịch bên ngoài app" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="SRT VIỆT" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <TextBlock Text="Nạp SRT Việt để tạo voice hoặc xuất video. Giữ nguyên số thứ tự và timecode; không cần SRT Trung hay AI dịch." Style="{StaticResource MutedTextStyle}" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="14"/>
                                        <Button x:Name="ImportSrtButton" Click="ImportSubtitle_Click" Content="📄  Thêm SRT Việt" HorizontalAlignment="Stretch" MinHeight="38" FontWeight="SemiBold" Background="{ThemeResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0" CornerRadius="8"/>
                                        <Border Padding="8,7" CornerRadius="7" Background="{ThemeResource InputSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="3">
                                                <TextBlock x:Name="SrtSummaryText" Style="{StaticResource MutedTextStyle}" Text="Chưa có SRT Việt." TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                                <TextBlock x:Name="AsrStatusText" Style="{StaticResource MutedTextStyle}" Text="Whisper timing chưa chạy." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="10"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Button x:Name="OpenTranslatedSrtButton" Click="OpenTranslatedSrt_Click" Content="Mở thư mục SRT đã lưu" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        <Button x:Name="SaveKaraokeAssButton" Click="SaveKaraokeAss_Click" Content="Lưu Caption ASS" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        <TextBlock x:Name="SubtitleStatusText" Style="{StaticResource MutedTextStyle}" Text="Thêm SRT Việt để bắt đầu." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="CHỈNH TỪNG CÂU" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Padding="6,2" CornerRadius="6" Background="{ThemeResource StrongSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="Timecode" FontSize="9" Foreground="{ThemeResource MutedTextBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Chọn câu để xem đúng timecode. Sửa lời Việt rồi bấm Lưu câu; file SRT gốc không bị ghi đè." Style="{StaticResource MutedTextStyle}" FontSize="10" TextWrapping="Wrap" LineHeight="14"/>
                                        <Border CornerRadius="8" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" Background="{ThemeResource InputSurfaceBrush}" Padding="2">
                                            <ListView x:Name="SubtitleCueList" MinHeight="150" MaxHeight="230" IsEnabled="False" SelectionChanged="SubtitleCueList_SelectionChanged" AutomationProperties.Name="Danh sách câu phụ đề"/>
                                        </Border>
                                        <TextBlock x:Name="SubtitleCueHeader" FontWeight="SemiBold" Text="Chưa chọn câu." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                        <TextBox x:Name="SubtitleVietnameseEdit" Header="Lời Việt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62" IsEnabled="False" TextChanged="SubtitleManualText_TextChanged"/>
                                        <Button x:Name="SubtitleSaveCueButton" Click="SubtitleSaveCue_Click" Content="Lưu câu" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        <Button x:Name="SubtitleSaveSrtButton" Click="SubtitleSaveSrt_Click" Content="Lưu SRT Việt" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        <Border Padding="8,7" CornerRadius="7" Background="{ThemeResource InputSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                            <TextBlock x:Name="SubtitleCueEditorStatus" Style="{StaticResource MutedTextStyle}" Text="Chọn SRT để mở danh sách câu." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="10" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="BlurInspectorPanel" Spacing="12" Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE771;" FontSize="15" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Blur / Mosaic / Cover" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Kéo trực tiếp trên Player · pixel-chính xác" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="TỌA ĐỘ (%)" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <NumberBox x:Name="RegionXBox" Header="X (%)" Minimum="0" Maximum="100" ValueChanged="RegionCoordinates_ValueChanged" />
                                            <NumberBox Grid.Column="1" x:Name="RegionYBox" Header="Y (%)" Minimum="0" Maximum="100" ValueChanged="RegionCoordinates_ValueChanged" />
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <NumberBox x:Name="RegionWidthBox" Header="Rộng (%)" Minimum="0" Maximum="100" ValueChanged="RegionCoordinates_ValueChanged" />
                                            <NumberBox Grid.Column="1" x:Name="RegionHeightBox" Header="Cao (%)" Minimum="0" Maximum="100" ValueChanged="RegionCoordinates_ValueChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="HIỆU ỨNG" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="EffectBox" Header="Hiệu ứng" SelectedIndex="0" SelectionChanged="EffectBox_SelectionChanged" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Tag="blur" Content="Làm mờ" /><ComboBoxItem Tag="mosaic" Content="Mosaic" /><ComboBoxItem Tag="cover" Content="Che đen" />
                                            </ComboBox>
                                            <NumberBox Grid.Column="1" x:Name="StrengthBox" Header="Cường độ" Minimum="2" Maximum="64" SmallChange="1" SpinButtonPlacementMode="Inline" Value="18" ValueChanged="EffectStrength_ValueChanged" />
                                        </Grid>
                                        <TextBlock Text="Cover là che đen mờ đục, không dùng cường độ." FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="THỜI GIAN" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <ToggleSwitch x:Name="WholeToggle" Header="Áp dụng toàn video" IsOn="True" Toggled="WholeToggle_Toggled"/>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <NumberBox x:Name="StartBox" Header="Bắt đầu (s)" IsEnabled="False" Minimum="0" SmallChange="0.1" LargeChange="1" SpinButtonPlacementMode="Inline" ValueChanged="EditInput_ValueChanged" />
                                            <NumberBox Grid.Column="1" x:Name="EndBox" Header="Kết thúc (s)" IsEnabled="False" Minimum="0" SmallChange="0.1" LargeChange="1" SpinButtonPlacementMode="Inline" ValueChanged="EditInput_ValueChanged" />
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button x:Name="EditorUseCurrentStartButton" Click="EditorUseCurrentStart_Click" Content="⏺ Lấy → đầu" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                            <Button Grid.Column="1" x:Name="EditorUseCurrentEndButton" Click="EditorUseCurrentEnd_Click" Content="⏺ Lấy → cuối" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Padding="8,7" CornerRadius="7" Background="{ThemeResource InputSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="RegionValidationText" Style="{StaticResource MutedTextStyle}" Text="Chọn video rồi kéo để tạo vùng." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                </Border>

                                <Button x:Name="AddRegionButton" Click="AddRegion_Click" Content="＋  Thêm vùng" IsEnabled="False" HorizontalAlignment="Stretch" MinHeight="38" CornerRadius="8" FontWeight="SemiBold" Background="{ThemeResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0"/>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="PRESET" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Button x:Name="SubtitlePresetButton" Click="SubtitlePreset_Click" Content="Mờ sub dưới" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Thêm vùng làm mờ phụ đề phía dưới" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                            <Button Grid.Column="1" x:Name="WatermarkPresetButton" Click="WatermarkPreset_Click" Content="Mosaic logo" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Thêm vùng Mosaic che logo góc phải" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="8" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" Background="{ThemeResource InputSurfaceBrush}" Padding="2">
                                    <ListView x:Name="RegionList" MinHeight="82" MaxHeight="130" SelectionChanged="RegionList_SelectionChanged" AutomationProperties.Name="Danh sách vùng hiệu ứng"/>
                                </Border>
                                <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="UndoButton" Click="Undo_Click" Content="↩ Hoàn tác" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" CornerRadius="8"/>
                                    <Button Grid.Column="1" x:Name="RedoButton" Click="Redo_Click" Content="↪ Làm lại" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" CornerRadius="8"/>
                                    <Button Grid.Column="2" x:Name="RemoveRegionButton" Click="RemoveRegion_Click" Content="Xóa" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" CornerRadius="8"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="AudioInspectorPanel" Spacing="12" Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="15" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Audio · Âm thanh gốc" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Preview &amp; Export dùng chung pipeline FFmpeg" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="CHẾ ĐỘ" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <ComboBox x:Name="SourceAudioModeBox" Header="Âm thanh gốc" SelectedIndex="0" SelectionChanged="SourceAudioMode_SelectionChanged" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Tag="keep" Content="Giữ nguyên" /><ComboBoxItem Tag="duck" Content="Giảm âm lượng" /><ComboBoxItem Tag="mute" Content="Tắt tiếng gốc" />
                                        </ComboBox>
                                        <TextBlock Text="File nguồn không bị thay đổi. Giữ/Duck/Mute áp dụng cho cả preview đã xử lý và bản xuất cuối." FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="14"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="MỨC GIẢM" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Slider x:Name="SourceAudioGainSlider" Header="Mức tiếng gốc khi giảm (%)" Minimum="5" Maximum="95" Value="35" IsEnabled="False" ValueChanged="SourceAudioGain_ValueChanged"/>
                                        <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Padding="6,2" CornerRadius="6" Background="{ThemeResource StrongSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"><TextBlock Text="5% ─ 95%" FontSize="9" Foreground="{ThemeResource MutedTextBrush}"/></Border>
                                            <TextBlock Grid.Column="1" Text="Chỉ hiệu lực khi chọn Giảm âm lượng (Duck)." FontSize="10" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Padding="8,7" CornerRadius="7" Background="{ThemeResource InputSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="AudioStatusText" Style="{StaticResource MutedTextStyle}" Text="Preview và video xuất sẽ giữ nguyên âm thanh gốc." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="VoiceInspectorPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Voice · NGHI-TTS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}" Opacity="0.85"/>
                                <ComboBox x:Name="AsrExecutionModeBox" Header="Nhận dạng nhịp thoại (ASR)" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Tag="gpu" Content="GPU ưu tiên (mặc định)"/>
                                    <ComboBoxItem Tag="cpu" Content="CPU"/>
                                    <ComboBoxItem Tag="hybrid" Content="Hybrid · CPU + GPU"/>
                                </ComboBox>
                                <TextBlock Text="Hybrid chia việc theo thiết bị rảnh, không đảm bảo nhanh hơn GPU. Đổi chế độ không xóa timing đã lưu; dùng nút dưới để phân tích lại." FontSize="10" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}"/>
                                <Button x:Name="AnalyzeTimingButton" Content="Phân tích nhịp theo chế độ đã chọn" Click="AnalyzeTiming_Click" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" ToolTipService.ToolTip="Dùng lại checkpoint hợp lệ; chỉ cập nhật timing và voice phụ thuộc khi phân tích thành công."/>
                                <Border Style="{StaticResource CardBorderStyle}" Padding="10">
                                    <StackPanel Spacing="8">
                                        <!-- Giọng đọc compact -->
                                        <Grid ColumnSpacing="6" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="VoiceModelBox" MinHeight="36" Height="36" Padding="8,0" SelectedIndex="0" VerticalAlignment="Center">
                                                <ComboBoxItem Tag="ngoc_huyen" Content="Ngọc Huyền · NGHI local"/>
                                            </ComboBox>
                                            <StackPanel x:Name="VoiceSampleSlot" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="0"/>
                                        </Grid>
                                        <!-- metadata chips single row -->
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border Padding="5,2" CornerRadius="5" Background="{ThemeResource StrongSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"><TextBlock Text="Local" FontSize="9" Foreground="{ThemeResource SecondaryTextBrush}"/></Border>
                                            <Border Padding="5,2" CornerRadius="5" Background="{ThemeResource StrongSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"><TextBlock Text="NGHI-TTS" FontSize="9" Foreground="{ThemeResource SecondaryTextBrush}"/></Border>
                                            <Border Padding="5,2" CornerRadius="5" Background="{ThemeResource StrongSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"><TextBlock Text="ONNX" FontSize="9" Foreground="{ThemeResource SecondaryTextBrush}"/></Border>
                                            <Border x:Name="VoiceSampleRateChip" Padding="5,2" CornerRadius="5" Background="{ThemeResource StrongSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"><TextBlock x:Name="VoiceSampleRateText" Text="22050 Hz" FontSize="9" Foreground="{ThemeResource SecondaryTextBrush}"/></Border>
                                            <TextBlock Text="Nguyên câu" FontSize="9" Foreground="{ThemeResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" ToolTipService.ToolTip="Mỗi cue đọc một lần, ghép theo timecode SRT; không cắt theo khoảng nghỉ Whisper"/>
                                        </StackPanel>
                                        <!-- main action button: Tạo voice / Hủy -->
                                        <Grid>
                                            <Button x:Name="GenerateTtsButton" Click="GenerateTts_Click" Content="✦  Tạo voice và tự canh timecode" IsEnabled="False" HorizontalAlignment="Stretch" MinHeight="36" Height="36" CornerRadius="8" FontWeight="SemiBold" Background="{ThemeResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0"/>
                                            <Button x:Name="CancelVoiceButton" Click="CancelVoice_Click" Content="Hủy tạo voice" HorizontalAlignment="Stretch" MinHeight="36" Height="36" CornerRadius="8" Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}"/>
                                        </Grid>
                                        <!-- progress/status only when running -->
                                        <StackPanel x:Name="VoiceProgressContainer" Spacing="5" Visibility="Collapsed">
                                            <ProgressBar x:Name="VoiceProgress" Minimum="0" Maximum="100" Height="3" CornerRadius="2" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                                            <TextBlock x:Name="VoiceStatusText" Style="{StaticResource MutedTextStyle}" Text="Chọn giọng rồi tạo voice." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="10" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <Rectangle Height="1" Fill="{ThemeResource BorderBrush}" Opacity="0.5"/>
                                        <!-- caption compact -->
                                        <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Caption theo từng từ" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="Karaoke highlight theo Word timing — áp dụng cho Preview/Export"/>
                                            <ToggleSwitch x:Name="KaraokeToggle" Grid.Column="1" IsOn="True" Toggled="Karaoke_Toggled" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="ImageInspectorPanel" Spacing="12" Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="15" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Ảnh / Logo" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                        <TextBlock Text="PNG · JPG · tối đa 8 · kéo trực tiếp" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="THÊM ẢNH" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Button x:Name="AddImageButton" Content="＋  Thêm ảnh / logo" HorizontalAlignment="Stretch" MinHeight="38" CornerRadius="8" FontWeight="SemiBold" Background="{ThemeResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0"/>
                                        <Border Padding="8,7" CornerRadius="7" Background="{ThemeResource InputSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                            <TextBlock x:Name="ImageStatusText" Style="{StaticResource MutedTextStyle}" Text="Chưa có ảnh/logo." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="VỊ TRÍ NHANH" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button x:Name="ImageTopLeftButton" Content="◰ Góc trái" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                            <Button Grid.Column="1" x:Name="ImageTopRightButton" Content="◳ Góc phải" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="TỌA ĐỘ &amp; KÍCH THƯỚC" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <NumberBox x:Name="ImageXBox" Header="X (%)" Minimum="0" Maximum="100" />
                                            <NumberBox Grid.Column="1" x:Name="ImageYBox" Header="Y (%)" Minimum="0" Maximum="100" />
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <NumberBox x:Name="ImageWidthBox" Header="Rộng (%)" Minimum="0" Maximum="100" />
                                            <NumberBox Grid.Column="1" x:Name="ImageHeightBox" Header="Cao (%)" Minimum="0" Maximum="100" />
                                        </Grid>
                                        <Slider x:Name="ImageOpacitySlider" Header="Độ hiện (%)" Minimum="5" Maximum="100" Value="100"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="RemoveImageButton" Content="Xóa ảnh/logo đang chọn" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" MinHeight="34"/>
                            </StackPanel>

                            <StackPanel x:Name="ExportInspectorPanel" Spacing="12" Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="15" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Export · Render" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Tạo bản mới · không ghi đè nguồn" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="NƠI LƯU" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Border Padding="8,7" CornerRadius="7" Background="{ThemeResource InputSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" MinHeight="36">
                                            <TextBlock x:Name="EditorOutputPathText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button x:Name="EditorChooseOutputButton" Content="📁 Chọn thư mục" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                            <Button Grid.Column="1" x:Name="EditorOpenOutputButton" Content="Mở thư mục" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="TÊN FILE" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <TextBox x:Name="FileNameBox" Header="Tên file đầu ra" PlaceholderText="video_edited.mp4" TextChanged="FileNameBox_TextChanged"/>
                                        <TextBlock Text="Tự thêm hậu tố nếu trùng tên. Giữ nguyên đuôi .mp4 để tương thích player." FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="XUẤT VIDEO" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button x:Name="RenderButton" Click="Render_Click" Content="⬆  Xuất video" IsEnabled="False" HorizontalAlignment="Stretch" MinHeight="40" CornerRadius="8" FontWeight="SemiBold" Background="{ThemeResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0"/>
                                            <Button Grid.Column="1" x:Name="CancelButton" Click="Cancel_Click" Content="Hủy" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" MinHeight="40"/>
                                        </Grid>
                                        <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource AccentPrimaryBrush}" AutomationProperties.Name="Tiến độ xuất video"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="10,7" Background="{ThemeResource RaisedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" Text="Sẵn sàng." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</Page>
