<Page
    x:Class="BiliSubStudio.App.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
    AutomationProperties.Name="Chỉnh video">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageRoot" Padding="24" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Chỉnh video" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Khoanh trực tiếp vùng Blur, Mosaic hoặc Cover; nguồn không bao giờ bị ghi đè." />
                </StackPanel>
                <Button Grid.Column="1" AccessKey="O" Click="Pick_Click" Content="Mở video" />
            </Grid>

            <Grid x:Name="WorkspaceGrid" Grid.Row="1" Height="600" ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                <Grid x:Name="PreviewPane" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="Black" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid AutomationProperties.Name="Khung xem trước và vùng chỉnh sửa">
                            <MediaPlayerElement x:Name="PreviewPlayer" AreTransportControlsEnabled="True" AutoPlay="False" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Trình phát video editor" />
                            <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Frame xem trước bằng FFmpeg" />
                            <Canvas
                                x:Name="Overlay"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                PointerPressed="Overlay_PointerPressed"
                                PointerMoved="Overlay_PointerMoved"
                                PointerReleased="Overlay_PointerReleased"
                                AutomationProperties.Name="Vùng kéo chọn hiệu ứng">
                                <shapes:Rectangle x:Name="SelectionRectangle" Stroke="#318EF2" StrokeThickness="2" Fill="#30318EF2" Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Spacing="6">
                        <Slider x:Name="Timeline" IsEnabled="False" ValueChanged="Timeline_ValueChanged" AutomationProperties.Name="Vị trí video editor" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClockText" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="00:00 / 00:00" />
                            <Button Grid.Column="1" x:Name="PlaybackButton" AccessKey="P" Click="Playback_Click" Content="Phát video" IsEnabled="False" />
                            <Button Grid.Column="2" x:Name="FullscreenButton" AccessKey="F" Click="Fullscreen_Click" Content="Toàn màn hình" IsEnabled="False" />
                            <ToggleSwitch Grid.Column="3" x:Name="SelectRegionButton" AccessKey="R" Toggled="SelectRegion_Toggled" OnContent="Đang khoanh" OffContent="Khoanh vùng" IsEnabled="False" />
                            <Button Grid.Column="4" x:Name="RefreshFrameButton" Click="Refresh_Click" Content="Cập nhật frame" IsEnabled="False" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="InspectorScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="7">
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Nguồn" />
                                <TextBlock x:Name="PathText" Style="{StaticResource MutedTextStyle}" Text="Chưa chọn video." TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaText" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="9">
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Vùng đang khoanh" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Kéo trên frame hoặc nhập tọa độ phần trăm để dùng hoàn toàn bằng bàn phím." />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="RegionXBox" Header="X (%)" Minimum="0" Maximum="100" SmallChange="1" ValueChanged="RegionCoordinates_ValueChanged" />
                                    <NumberBox Grid.Column="1" x:Name="RegionYBox" Header="Y (%)" Minimum="0" Maximum="100" SmallChange="1" ValueChanged="RegionCoordinates_ValueChanged" />
                                    <NumberBox Grid.Column="2" x:Name="RegionWidthBox" Header="Rộng (%)" Minimum="0" Maximum="100" SmallChange="1" ValueChanged="RegionCoordinates_ValueChanged" />
                                    <NumberBox Grid.Column="3" x:Name="RegionHeightBox" Header="Cao (%)" Minimum="0" Maximum="100" SmallChange="1" ValueChanged="RegionCoordinates_ValueChanged" />
                                </Grid>
                                <TextBlock x:Name="RegionValidationText" Style="{StaticResource MutedTextStyle}" Text="Chọn video rồi khoanh hoặc nhập vùng." AutomationProperties.LiveSetting="Polite" />
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="EffectBox" Header="Hiệu ứng" SelectedIndex="0"><x:String>blur</x:String><x:String>mosaic</x:String><x:String>cover</x:String></ComboBox>
                                    <NumberBox Grid.Column="1" x:Name="StrengthBox" Header="Cường độ" Minimum="2" Maximum="64" Value="18" ValueChanged="EditInput_ValueChanged" />
                                </Grid>
                                <ToggleSwitch x:Name="WholeToggle" Header="Áp dụng toàn video" IsOn="True" Toggled="WholeToggle_Toggled" />
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="StartBox" Header="Bắt đầu (s)" IsEnabled="False" ValueChanged="EditInput_ValueChanged" />
                                    <NumberBox Grid.Column="1" x:Name="EndBox" Header="Kết thúc (s)" IsEnabled="False" ValueChanged="EditInput_ValueChanged" />
                                </Grid>
                                <Button x:Name="AddRegionButton" Click="AddRegion_Click" Content="Thêm vùng" IsEnabled="False" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Danh sách vùng" />
                                <ListView x:Name="RegionList" Height="130" SelectionChanged="RegionList_SelectionChanged" AutomationProperties.Name="Danh sách vùng hiệu ứng" />
                                <Button x:Name="RemoveRegionButton" Click="RemoveRegion_Click" Content="Xóa vùng chọn" IsEnabled="False" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBox x:Name="FileNameBox" Header="Tên file đầu ra" PlaceholderText="video_edited.mp4" TextChanged="FileNameBox_TextChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="RenderButton" Click="Render_Click" Content="Xuất video" IsEnabled="False" />
                                    <Button x:Name="CancelButton" Click="Cancel_Click" Content="Hủy" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" AutomationProperties.Name="Tiến độ xuất video" />
                                <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" Text="Sẵn sàng." AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <TextBlock Grid.Row="2" Style="{StaticResource MutedTextStyle}" Text="H.264/HEVC tương thích phát bằng player native; frame FFmpeg dùng để khoanh chính xác. Export H.264/yuv420p + AAC cho MP4." />
        </Grid>
    </ScrollViewer>
</Page>
