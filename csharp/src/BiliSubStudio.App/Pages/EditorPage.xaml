<Page
    x:Class="BiliSubStudio.App.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource CanvasBrush}"
    AutomationProperties.Name="Chỉnh video"
    IsTabStop="True"
    KeyDown="Page_KeyDown">
    <Grid x:Name="PageRoot" Padding="12,10,12,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock FontSize="10" Foreground="{ThemeResource MutedTextBrush}" Text="BiliSub Studio / Chỉnh video" />
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Chỉnh video" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Padding="8,3" Background="{ThemeResource AccentSoftBrush}" CornerRadius="9">
                    <TextBlock FontSize="10" Foreground="{ThemeResource AccentPrimaryBrush}" Text="Project tự lưu" />
                </Border>
                <Border Padding="8,3" Background="{ThemeResource SuccessSoftBrush}" CornerRadius="9">
                    <TextBlock FontSize="10" Foreground="{ThemeResource SuccessBrush}" Text="Không ghi đè nguồn" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SourceColumn" Width="0.75*" MinWidth="120" MaxWidth="210" />
                <ColumnDefinition x:Name="PlayerColumn" Width="2.4*" MinWidth="220" />
                <ColumnDefinition x:Name="DetailsColumn" Width="1.15*" MinWidth="190" MaxWidth="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="10" Background="{ThemeResource RaisedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="Source" />
                        <Button Grid.Column="1" x:Name="OpenVideoButton" AccessKey="O" Click="OpenVideo_Click" Content="Mở video" Padding="9,5" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Video" />
                                <TextBlock x:Name="PathText" Style="{StaticResource MutedTextStyle}" Text="Chưa chọn video." TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource BorderBrush}" />
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="SRT" />
                                <TextBlock x:Name="SrtPathText" Style="{StaticResource MutedTextStyle}" Text="Chưa chọn SRT." TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource BorderBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="Ảnh / logo" />
                                <ListView x:Name="ImageSourceList" MinHeight="74" MaxHeight="130" AutomationProperties.Name="Danh sách ảnh và logo nguồn" />
                                <TextBlock FontSize="10" Foreground="{ThemeResource SecondaryTextBrush}" Text="Tối đa 8 ảnh. Chỉnh vị trí ở tool Ảnh/Logo." TextWrapping="Wrap" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource BorderBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="Project" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Tự lưu thay đổi · source media luôn giữ nguyên." TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="EditorAutoCompositeToggle" Header="Tự cập nhật preview" IsOn="True" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid x:Name="PreviewPane" Grid.Column="1">
                <Border x:Name="PreviewSurface" Background="Black" BorderBrush="{ThemeResource StrongBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid AutomationProperties.Name="Player Editor">
                        <MediaPlayerElement x:Name="PreviewPlayer" AreTransportControlsEnabled="False" AutoPlay="False" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Video preview" />
                        <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Frame preview" />
                        <Canvas x:Name="Overlay" Background="Transparent" IsHitTestVisible="False"
                                PointerPressed="Overlay_PointerPressed" PointerMoved="Overlay_PointerMoved"
                                PointerReleased="Overlay_PointerReleased" PointerCanceled="Overlay_PointerCanceled"
                                AutomationProperties.Name="Vùng chỉnh trực tiếp" />
                        <Canvas x:Name="ImageOverlayCanvas" Background="Transparent" IsHitTestVisible="False" AutomationProperties.Name="Ảnh và logo trên preview" />

                        <Border x:Name="PlayerControlBar" Height="48" VerticalAlignment="Bottom" Margin="8" Padding="8,5" Background="#D9000000" CornerRadius="9">
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PlayerPlayPauseButton" Click="PlayerPlayPause_Click" Content="▶" IsEnabled="False" Padding="0" HorizontalContentAlignment="Center" ToolTipService.ToolTip="Phát / tạm dừng preview" />
                                <TextBlock Grid.Column="1" x:Name="ClockText" VerticalAlignment="Center" Foreground="White" FontSize="11" Text="00:00 / 00:00" />
                                <Slider Grid.Column="2" x:Name="Timeline" Minimum="0" IsEnabled="False" ValueChanged="Timeline_ValueChanged" VerticalAlignment="Center" AutomationProperties.Name="Vị trí video" />
                                <ToggleSwitch Grid.Column="3" x:Name="PreviewMuteToggle" Toggled="PreviewMute_Toggled" OffContent="" OnContent="" MinWidth="0" HorizontalAlignment="Center" ToolTipService.ToolTip="Tắt / bật tiếng" />
                                <Slider Grid.Column="4" x:Name="PreviewVolumeSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="PreviewVolume_ValueChanged" VerticalAlignment="Center" AutomationProperties.Name="Âm lượng preview" />
                                <Button Grid.Column="5" x:Name="FullscreenButton" AccessKey="F" Click="Fullscreen_Click" Content="⛶" IsEnabled="False" Padding="0" HorizontalContentAlignment="Center" ToolTipService.ToolTip="Toàn màn hình" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Padding="9" Background="{ThemeResource RaisedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Details" />
                        <Grid x:Name="ToolSelectorGrid" ColumnSpacing="5" RowSpacing="5">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ToggleButton x:Name="SubtitleModeButton" Grid.Row="0" Grid.Column="0" Height="32" Tag="Subtitle" Content="Subtitle" IsChecked="True" />
                            <ToggleButton x:Name="BlurModeButton" Grid.Row="0" Grid.Column="1" Height="32" Tag="Blur" Content="Blur" />
                            <ToggleButton x:Name="AudioModeButton" Grid.Row="1" Grid.Column="0" Height="32" Tag="Audio" Content="Audio" />
                            <ToggleButton x:Name="VoiceModeButton" Grid.Row="1" Grid.Column="1" Height="32" Tag="Voice" Content="Voice" />
                            <ToggleButton x:Name="ImageModeButton" Grid.Row="2" Grid.Column="0" Height="32" Tag="Image" Content="Ảnh/Logo" />
                            <ToggleButton x:Name="ExportModeButton" Grid.Row="2" Grid.Column="1" Height="32" Tag="Export" Content="Export" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer x:Name="InspectorScroll" Grid.Row="1" Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="DetailsPanelHost">
                            <StackPanel x:Name="SubtitleInspectorPanel" Spacing="10">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Subtitle / Vietsub" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="SRT Trung → Việt bằng AI local + skill. Timecode và thứ tự block được giữ nguyên." TextWrapping="Wrap" />
                                <Button x:Name="ImportSrtButton" Click="ImportSubtitle_Click" Content="Chọn SRT tiếng Trung" />
                                <TextBlock x:Name="AsrStatusText" Style="{StaticResource MutedTextStyle}" Text="Whisper timing chưa chạy." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="SrtSummaryText" Style="{StaticResource MutedTextStyle}" Text="Skill: Dịch Trung Tu Tiên." TextWrapping="Wrap" />
                                <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="PrepareAiButton" Click="PrepareAi_Click" Content="Chuẩn bị AI" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Grid.Column="1" x:Name="TranslateButton" Click="Translate_Click" Content="Vietsub" IsEnabled="False" />
                                </Grid>
                                <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="CancelTranslationButton" Click="CancelTranslation_Click" Content="Hủy AI" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" />
                                    <Button Grid.Column="1" x:Name="OpenTranslatedSrtButton" Click="OpenTranslatedSrt_Click" Content="Mở SRT Việt" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                                <Button x:Name="SaveKaraokeAssButton" Click="SaveKaraokeAss_Click" Content="Lưu Caption ASS" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                <ProgressBar x:Name="TranslationProgress" Minimum="0" Maximum="100" />
                                <TextBlock x:Name="TranslationStatusText" Style="{StaticResource MutedTextStyle}" Text="Chưa chuẩn bị AI local." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <Rectangle Height="1" Fill="{ThemeResource BorderBrush}" Margin="0,2" />
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Chỉnh từng câu SRT" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Chọn câu để đưa Player tới đúng timecode. Có thể sửa lời Trung/Việt, khóa câu hoặc dịch lại riêng câu bằng AI local." TextWrapping="Wrap" />
                                <ListView x:Name="SubtitleCueList" MinHeight="150" MaxHeight="230" IsEnabled="False" SelectionChanged="SubtitleCueList_SelectionChanged" AutomationProperties.Name="Danh sách câu phụ đề" />
                                <TextBlock x:Name="SubtitleCueHeader" FontWeight="SemiBold" Text="Chưa chọn câu." TextWrapping="Wrap" />
                                <TextBox x:Name="SubtitleSourceEdit" Header="Lời Trung / nguồn" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62" IsEnabled="False" TextChanged="SubtitleManualText_TextChanged" />
                                <TextBox x:Name="SubtitleVietnameseEdit" Header="Lời Việt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62" IsEnabled="False" TextChanged="SubtitleManualText_TextChanged" />
                                <ToggleSwitch x:Name="SubtitleLockToggle" Header="Khóa câu — Vietsub toàn bộ không ghi đè" IsEnabled="False" Toggled="SubtitleLock_Toggled" />
                                <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="SubtitleSaveCueButton" Click="SubtitleSaveCue_Click" Content="Lưu câu" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Grid.Column="1" x:Name="SubtitleRetranslateCueButton" Click="SubtitleRetranslateCue_Click" Content="Dịch lại câu" IsEnabled="False" />
                                </Grid>
                                <Button x:Name="SubtitleSaveSrtButton" Click="SubtitleSaveSrt_Click" Content="Lưu SRT Việt" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                <TextBlock x:Name="SubtitleCueEditorStatus" Style="{StaticResource MutedTextStyle}" Text="Chọn SRT để mở danh sách câu." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>

                            <StackPanel x:Name="BlurInspectorPanel" Spacing="10" Visibility="Collapsed">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Blur / Mosaic / Cover" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Kéo trực tiếp vùng trên Player; dùng tọa độ khi cần chính xác." TextWrapping="Wrap" />
                                <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="RegionXBox" Header="X (%)" Minimum="0" Maximum="100" ValueChanged="RegionCoordinates_ValueChanged" />
                                    <NumberBox Grid.Column="1" x:Name="RegionYBox" Header="Y (%)" Minimum="0" Maximum="100" ValueChanged="RegionCoordinates_ValueChanged" />
                                </Grid>
                                <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="RegionWidthBox" Header="Rộng (%)" Minimum="0" Maximum="100" ValueChanged="RegionCoordinates_ValueChanged" />
                                    <NumberBox Grid.Column="1" x:Name="RegionHeightBox" Header="Cao (%)" Minimum="0" Maximum="100" ValueChanged="RegionCoordinates_ValueChanged" />
                                </Grid>
                                <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="EffectBox" Header="Hiệu ứng" SelectedIndex="0" SelectionChanged="EffectBox_SelectionChanged">
                                        <ComboBoxItem Tag="blur" Content="Làm mờ" /><ComboBoxItem Tag="mosaic" Content="Mosaic" /><ComboBoxItem Tag="cover" Content="Che đen" />
                                    </ComboBox>
                                    <NumberBox Grid.Column="1" x:Name="StrengthBox" Header="Cường độ" Minimum="2" Maximum="40" Value="18" ValueChanged="EditInput_ValueChanged" />
                                </Grid>
                                <ToggleSwitch x:Name="WholeToggle" Header="Áp dụng toàn video" IsOn="True" Toggled="WholeToggle_Toggled" />
                                <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="StartBox" Header="Bắt đầu (s)" IsEnabled="False" ValueChanged="EditInput_ValueChanged" />
                                    <NumberBox Grid.Column="1" x:Name="EndBox" Header="Kết thúc (s)" IsEnabled="False" ValueChanged="EditInput_ValueChanged" />
                                </Grid>
                                <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="EditorUseCurrentStartButton" Content="Lấy thời điểm → đầu" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Grid.Column="1" x:Name="EditorUseCurrentEndButton" Content="Lấy thời điểm → cuối" Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                                <TextBlock x:Name="RegionValidationText" Style="{StaticResource MutedTextStyle}" Text="Chọn video rồi kéo để tạo vùng." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="AddRegionButton" Click="AddRegion_Click" Content="Thêm vùng" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button x:Name="SubtitlePresetButton" Click="SubtitlePreset_Click" Content="Preset sub" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="WatermarkPresetButton" Click="WatermarkPreset_Click" Content="Preset logo" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                                <ListView x:Name="RegionList" MinHeight="82" MaxHeight="130" SelectionChanged="RegionList_SelectionChanged" AutomationProperties.Name="Danh sách vùng hiệu ứng" />
                                <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="UndoButton" Click="Undo_Click" Content="Hoàn tác" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Grid.Column="1" x:Name="RedoButton" Click="Redo_Click" Content="Làm lại" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Grid.Column="2" x:Name="RemoveRegionButton" Click="RemoveRegion_Click" Content="Xóa" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="AudioInspectorPanel" Spacing="10" Visibility="Collapsed">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Audio" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Điều khiển âm thanh gốc trong preview và bản xuất. File nguồn không bị thay đổi." TextWrapping="Wrap" />
                                <ComboBox x:Name="SourceAudioModeBox" Header="Âm thanh gốc" SelectedIndex="0" SelectionChanged="SourceAudioMode_SelectionChanged">
                                    <ComboBoxItem Tag="keep" Content="Giữ nguyên" /><ComboBoxItem Tag="duck" Content="Giảm âm lượng" /><ComboBoxItem Tag="mute" Content="Tắt tiếng gốc" />
                                </ComboBox>
                                <Slider x:Name="SourceAudioGainSlider" Header="Mức tiếng gốc khi giảm (%)" Minimum="5" Maximum="95" Value="35" IsEnabled="False" ValueChanged="SourceAudioGain_ValueChanged" />
                                <TextBlock x:Name="AudioStatusText" Style="{StaticResource MutedTextStyle}" Text="Preview và video xuất sẽ giữ nguyên âm thanh gốc." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>

                            <StackPanel x:Name="VoiceInspectorPanel" Spacing="10" Visibility="Collapsed">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Voice" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Whisper lấy timing + gợi ý Nam/Nữ; voice Việt chạy local." TextWrapping="Wrap" />
                                <Button x:Name="CreateAsrButton" Click="CreateAsr_Click" Content="Phân tích nhịp + Nam/Nữ" IsEnabled="False" />
                                <Button x:Name="GenerateTtsButton" Click="GenerateTts_Click" Content="Tạo voice Việt local" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                <ToggleSwitch x:Name="KaraokeToggle" Header="Caption theo từng từ" IsOn="True" Toggled="Karaoke_Toggled" />
                                <ComboBox x:Name="CurrentCueVoiceBox" Header="Voice câu hiện tại" SelectedIndex="0" SelectionChanged="CurrentCueVoice_SelectionChanged">
                                    <ComboBoxItem Tag="auto" Content="Tự động Nam/Nữ" /><ComboBoxItem Tag="male" Content="Ép voice Nam" /><ComboBoxItem Tag="female" Content="Ép voice Nữ" />
                                </ComboBox>
                                <ProgressBar x:Name="VoiceProgress" Minimum="0" Maximum="100" />
                                <TextBlock x:Name="VoiceStatusText" Style="{StaticResource MutedTextStyle}" Text="Chưa phân tích nhịp thoại." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="CancelVoiceButton" Click="CancelVoice_Click" Content="Hủy phân tích / voice" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" />
                            </StackPanel>

                            <StackPanel x:Name="ImageInspectorPanel" Spacing="10" Visibility="Collapsed">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Ảnh / Logo" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="PNG, JPG, JPEG. Kéo và resize trực tiếp trên Player." TextWrapping="Wrap" />
                                <Button x:Name="AddImageButton" Content="Thêm ảnh / logo" />
                                <TextBlock x:Name="ImageStatusText" Style="{StaticResource MutedTextStyle}" Text="Chưa có ảnh/logo." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="ImageTopLeftButton" Content="Góc trái" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Grid.Column="1" x:Name="ImageTopRightButton" Content="Góc phải" Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                                <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="ImageXBox" Header="X (%)" Minimum="0" Maximum="100" />
                                    <NumberBox Grid.Column="1" x:Name="ImageYBox" Header="Y (%)" Minimum="0" Maximum="100" />
                                </Grid>
                                <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="ImageWidthBox" Header="Rộng (%)" Minimum="0" Maximum="100" />
                                    <NumberBox Grid.Column="1" x:Name="ImageHeightBox" Header="Cao (%)" Minimum="0" Maximum="100" />
                                </Grid>
                                <Slider x:Name="ImageOpacitySlider" Header="Độ hiện (%)" Minimum="5" Maximum="100" Value="100" />
                                <Button x:Name="RemoveImageButton" Content="Xóa ảnh/logo đang chọn" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" />
                            </StackPanel>

                            <StackPanel x:Name="ExportInspectorPanel" Spacing="10" Visibility="Collapsed">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Export" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Xuất bản chỉnh mới; không ghi đè video nguồn." TextWrapping="Wrap" />
                                <TextBlock FontWeight="SemiBold" Text="Nơi lưu" />
                                <TextBlock x:Name="EditorOutputPathText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="EditorChooseOutputButton" Content="Chọn thư mục" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Grid.Column="1" x:Name="EditorOpenOutputButton" Content="Mở thư mục" Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                                <TextBox x:Name="FileNameBox" Header="Tên file đầu ra" PlaceholderText="video_edited.mp4" TextChanged="FileNameBox_TextChanged" />
                                <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="RenderButton" Click="Render_Click" Content="Xuất video" IsEnabled="False" />
                                    <Button Grid.Column="1" x:Name="CancelButton" Click="Cancel_Click" Content="Hủy" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" />
                                </Grid>
                                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" AutomationProperties.Name="Tiến độ xuất video" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="10,7" Background="{ThemeResource RaisedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" Text="Sẵn sàng." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</Page>
