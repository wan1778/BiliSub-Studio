                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="ImageInspectorPanel" Spacing="12" Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="15" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Ảnh / Logo" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                        <TextBlock Text="PNG · JPG · tối đa 8 · kéo trực tiếp" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="THÊM ẢNH" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Button x:Name="AddImageButton" Content="＋  Thêm ảnh / logo" HorizontalAlignment="Stretch" MinHeight="38" CornerRadius="8" FontWeight="SemiBold" Background="{ThemeResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0"/>
                                        <Border Padding="8,7" CornerRadius="7" Background="{ThemeResource InputSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                            <TextBlock x:Name="ImageStatusText" Style="{StaticResource MutedTextStyle}" Text="Chưa có ảnh/logo." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="VỊ TRÍ NHANH" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button x:Name="ImageTopLeftButton" Content="◰ Góc trái" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                            <Button Grid.Column="1" x:Name="ImageTopRightButton" Content="◳ Góc phải" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="TỌA ĐỘ &amp; KÍCH THƯỚC" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <NumberBox x:Name="ImageXBox" Header="X (%)" Minimum="0" Maximum="100" />
                                            <NumberBox Grid.Column="1" x:Name="ImageYBox" Header="Y (%)" Minimum="0" Maximum="100" />
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <NumberBox x:Name="ImageWidthBox" Header="Rộng (%)" Minimum="0" Maximum="100" />
                                            <NumberBox Grid.Column="1" x:Name="ImageHeightBox" Header="Cao (%)" Minimum="0" Maximum="100" />
                                        </Grid>
                                        <Slider x:Name="ImageOpacitySlider" Header="Độ hiện (%)" Minimum="5" Maximum="100" Value="100"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="RemoveImageButton" Content="Xóa ảnh/logo đang chọn" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" MinHeight="34"/>
                            </StackPanel>

                            <StackPanel x:Name="ExportInspectorPanel" Spacing="12" Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="15" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Export · Render" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Tạo bản mới · không ghi đè nguồn" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="NƠI LƯU" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Border Padding="8,7" CornerRadius="7" Background="{ThemeResource InputSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" MinHeight="36">
                                            <TextBlock x:Name="EditorOutputPathText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button x:Name="EditorChooseOutputButton" Content="📁 Chọn thư mục" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                            <Button Grid.Column="1" x:Name="EditorOpenOutputButton" Content="Mở thư mục" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="TÊN FILE" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <TextBox x:Name="FileNameBox" Header="Tên file đầu ra" PlaceholderText="video_edited.mp4" TextChanged="FileNameBox_TextChanged"/>
                                        <TextBlock Text="Tự thêm hậu tố nếu trùng tên. Giữ nguyên đuôi .mp4 để tương thích player." FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="CẮT VIDEO · GIỮ LẠI" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <TextBlock Text="Đặt mốc đầu/cuối theo thời gian video nguồn. Muốn bỏ vài phút cuối: kéo timeline tới điểm cần kết thúc rồi bấm Đặt cuối." FontSize="10" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <NumberBox x:Name="TrimStartBox" Header="Bắt đầu (giây)" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="TrimRange_ValueChanged"/>
                                            <NumberBox Grid.Column="1" x:Name="TrimEndBox" Header="Kết thúc (giây)" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="TrimRange_ValueChanged"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Button x:Name="TrimUseCurrentStartButton" Click="TrimUseCurrentStart_Click" Content="Đặt đầu tại vị trí hiện tại" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                            <Button Grid.Column="1" x:Name="TrimUseCurrentEndButton" Click="TrimUseCurrentEnd_Click" Content="Đặt cuối tại vị trí hiện tại" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>
                                        <Button x:Name="TrimResetButton" Click="TrimReset_Click" Content="Giữ toàn bộ video" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        <TextBlock x:Name="TrimSummaryText" Text="Giữ toàn bộ video." FontSize="10" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="XUẤT VIDEO" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button x:Name="RenderButton" Click="Render_Click" Content="⬆  Xuất video" IsEnabled="False" HorizontalAlignment="Stretch" MinHeight="40" CornerRadius="8" FontWeight="SemiBold" Background="{ThemeResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0"/>
                                            <Button Grid.Column="1" x:Name="CancelButton" Click="Cancel_Click" Content="Hủy" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" MinHeight="40"/>
                                        </Grid>
                                        <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource AccentPrimaryBrush}" AutomationProperties.Name="Tiến độ xuất video"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="10,7" Background="{ThemeResource RaisedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" Text="Sẵn sàng." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>

    <ContentDialog x:Name="ExportVideoDialog" Width="844" MinWidth="844" MaxWidth="844" Padding="0" RequestedTheme="Dark" Opened="ExportVideoDialog_Opened">
        <ContentDialog.Resources>
            <x:Double x:Key="ContentDialogMinWidth">844</x:Double>
            <x:Double x:Key="ContentDialogMaxWidth">844</x:Double>
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#101C2D" />
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#F5F8FC" />
            <SolidColorBrush x:Key="ExportCardBrush" Color="#111E2D" />
            <SolidColorBrush x:Key="ExportCardBorderBrush" Color="#2A3A52" />
            <SolidColorBrush x:Key="ExportAccentBrush" Color="#24C5E5" />
            <Style x:Key="ExportSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource ExportAccentBrush}" />
            </Style>
            <Style x:Key="ExportActionButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="138" />
                <Setter Property="Height" Value="48" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
        </ContentDialog.Resources>

        <Grid Width="820" Background="#101C2D">
            <Grid.RowDefinitions><RowDefinition Height="86" /><RowDefinition Height="*" /><RowDefinition Height="74" /></Grid.RowDefinitions>
            <Grid Padding="24,18,20,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Xuất video" FontSize="25" FontWeight="SemiBold" Foreground="#F5F8FC" />
                    <TextBlock Text="Thiết lập file đầu ra" FontSize="14" Foreground="#AAB7C9" />
                </StackPanel>
                <Button Grid.Column="1" Width="36" Height="36" Padding="0" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="14" Background="Transparent" BorderThickness="0" Foreground="#AAB7C9" Click="ExportDialogCancel_Click" ToolTipService.ToolTip="Đóng" />
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="22,0,22,10" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.28*" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="10">
                    <Border Padding="17,14" Background="{StaticResource ExportCardBrush}" BorderBrush="{StaticResource ExportCardBorderBrush}" BorderThickness="1" CornerRadius="9">
                        <StackPanel Spacing="9">
                            <TextBlock Text="FILE ĐẦU RA" Style="{StaticResource ExportSectionTitleStyle}" />
                            <TextBox x:Name="ExportDialogFileNameBox" Header="Tên file" PlaceholderText="video_edited.mp4" />
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ExportDialogDirectoryBox" Header="Thư mục lưu" IsReadOnly="True" TextWrapping="NoWrap" />
                                <Button Grid.Column="1" x:Name="ExportDialogChooseDirectoryButton" Content="Chọn" Click="ExportDialogChooseDirectory_Click" VerticalAlignment="Bottom" MinHeight="34" Padding="17,6" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="17,14" Background="{StaticResource ExportCardBrush}" BorderBrush="{StaticResource ExportCardBorderBrush}" BorderThickness="1" CornerRadius="9">
                        <StackPanel Spacing="9">
                            <TextBlock Text="VIDEO" Style="{StaticResource ExportSectionTitleStyle}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="ExportDialogContainerBox" Header="Định dạng" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ExportDialogSetting_Changed"><ComboBoxItem Content="MP4" Tag="mp4" /><ComboBoxItem Content="MKV" Tag="mkv" /></ComboBox>
                                <ComboBox Grid.Column="1" x:Name="ExportDialogCodecBox" Header="Mã hóa" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ExportDialogSetting_Changed"><ComboBoxItem Content="H.264 (Tương thích)" Tag="h264" /><ComboBoxItem Content="H.265 (Nhẹ hơn)" Tag="hevc" /></ComboBox>
                            </Grid>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Chất lượng" FontSize="13" Foreground="#DDE5F0" />
                                <Grid ColumnSpacing="0">
                                    <Grid.Resources>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#24BFE0" /><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#32CBEA" /><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#1EABC9" />
                                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" /><SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" /><SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="ExportDialogQualityHighButton" Content="Cao" IsChecked="True" Click="ExportDialogQuality_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="7,0,0,7" />
                                    <ToggleButton Grid.Column="1" x:Name="ExportDialogQualityStandardButton" Content="Chuẩn" Click="ExportDialogQuality_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="0" />
                                    <ToggleButton Grid.Column="2" x:Name="ExportDialogQualityCompactButton" Content="Tiết kiệm" Click="ExportDialogQuality_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="0,7,7,0" />
                                </Grid>
                            </StackPanel>
                            <ComboBox x:Name="ExportDialogResolutionBox" Header="Độ phân giải" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ExportDialogSetting_Changed"><ComboBoxItem Content="Giữ nguyên nguồn" Tag="source" /><ComboBoxItem Content="4K · 2160p" Tag="2160" /><ComboBoxItem Content="Full HD · 1080p" Tag="1080" /><ComboBoxItem Content="HD · 720p" Tag="720" /><ComboBoxItem Content="SD · 480p" Tag="480" /></ComboBox>
                            <ComboBox x:Name="ExportDialogFpsBox" Header="FPS" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ExportDialogSetting_Changed"><ComboBoxItem Content="Giữ nguyên nguồn" Tag="source" /><ComboBoxItem Content="24 FPS" Tag="24" /><ComboBoxItem Content="25 FPS" Tag="25" /><ComboBoxItem Content="30 FPS" Tag="30" /><ComboBoxItem Content="50 FPS" Tag="50" /><ComboBoxItem Content="60 FPS" Tag="60" /></ComboBox>
                            <ToggleSwitch x:Name="ExportDialogGpuToggle" Header="Tăng tốc GPU" IsOn="True" Toggled="ExportDialogSetting_Changed" />
                            <TextBlock Text="Tự động dùng NVIDIA NVENC khi khả dụng" FontSize="11" Foreground="#92A2B8" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Padding="17,14" Background="{StaticResource ExportCardBrush}" BorderBrush="{StaticResource ExportCardBorderBrush}" BorderThickness="1" CornerRadius="9">
                        <StackPanel Spacing="10">
                            <TextBlock Text="ÂM THANH" Style="{StaticResource ExportSectionTitleStyle}" />
                            <ComboBox Header="Định dạng" SelectedIndex="0" IsEnabled="False" HorizontalAlignment="Stretch"><x:String>AAC</x:String></ComboBox>
                            <ComboBox x:Name="ExportDialogAudioBitrateBox" Header="Bitrate" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="ExportDialogSetting_Changed"><ComboBoxItem Content="128 kbps" Tag="128" /><ComboBoxItem Content="192 kbps" Tag="192" /><ComboBoxItem Content="256 kbps" Tag="256" /><ComboBoxItem Content="320 kbps" Tag="320" /></ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Margin="0,10,0,0" Padding="18" MinHeight="126" VerticalAlignment="Bottom" Background="#142236" BorderBrush="{StaticResource ExportCardBorderBrush}" BorderThickness="1" CornerRadius="9">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEDA2;" FontSize="34" Foreground="{ThemeResource SuccessBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="ExportDialogEstimateText" Text="Ước tính: đang tính..." FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ExportDialogDurationText" Text="Thời lượng: --:--:--" FontSize="14" Foreground="#B3C0D2" />
                                <TextBlock Text="Dung lượng thay đổi theo nội dung và chất lượng đã chọn." FontSize="10" Foreground="#8190A5" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock Grid.ColumnSpan="2" x:Name="ExportDialogValidationText" Margin="3,10,3,0" VerticalAlignment="Top" Foreground="{ThemeResource DangerBrush}" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#2A3A52" BorderThickness="0,1,0,0" Background="#101B2A">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                    <Button x:Name="ExportDialogCancelButton" Content="Hủy" Click="ExportDialogCancel_Click" Style="{StaticResource ExportActionButtonStyle}" Background="Transparent" BorderBrush="#607089" BorderThickness="1" Foreground="#F0F4FA" />
                    <Button x:Name="ExportDialogConfirmButton" Content="Bắt đầu xuất" Click="ExportDialogStart_Click" Style="{StaticResource ExportActionButtonStyle}" MinWidth="152" Background="{StaticResource ExportAccentBrush}" BorderThickness="0" Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>
    </ContentDialog>
    </Grid>
</Page>
