<Page
    x:Class="BiliSubStudio.App.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource CanvasBrush}"
    AutomationProperties.Name="Chỉnh video"
    IsTabStop="True"
    KeyDown="Page_KeyDown">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageRoot" Padding="24,18,24,28" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock FontSize="10" Foreground="{ThemeResource MutedTextBrush}" Text="BiliSub Studio / Chỉnh video" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Chỉnh video" />
                        <Border Margin="0,5,0,0" Padding="9,4" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="11">
                            <TextBlock FontSize="10" Foreground="{ThemeResource AccentPrimaryBrush}" Text="Project tự lưu" />
                        </Border>
                        <Border Margin="0,5,0,0" Padding="9,4" Background="{ThemeResource SuccessSoftBrush}" BorderBrush="{ThemeResource SuccessBrush}" BorderThickness="1" CornerRadius="11">
                            <TextBlock FontSize="10" Foreground="{ThemeResource SuccessBrush}" Text="FFmpeg an toàn" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Kéo trực tiếp để tạo vùng; chọn vùng để di chuyển hoặc kéo tám điểm điều chỉnh. File nguồn không bị ghi đè." />
                </StackPanel>
                <Button Grid.Column="1" x:Name="OpenVideoButton" AccessKey="O" Click="Pick_Click" Content="Mở video" />
            </Grid>

            <Grid x:Name="WorkspaceGrid" Grid.Row="1" Height="620" ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                <Grid x:Name="PreviewPane" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="Black" BorderBrush="{ThemeResource StrongBorderBrush}" BorderThickness="1" CornerRadius="13">
                        <Grid AutomationProperties.Name="Khung xem trước và vùng chỉnh sửa">
                            <MediaPlayerElement x:Name="PreviewPlayer" AreTransportControlsEnabled="True" AutoPlay="False" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Trình phát video editor" />
                            <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Frame đã áp dụng hiệu ứng" />
                            <Canvas
                                x:Name="Overlay"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                PointerPressed="Overlay_PointerPressed"
                                PointerMoved="Overlay_PointerMoved"
                                PointerReleased="Overlay_PointerReleased"
                                PointerCanceled="Overlay_PointerCanceled"
                                AutomationProperties.Name="Các vùng hiệu ứng chỉnh trực tiếp" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Spacing="6">
                        <Grid Height="28">
                            <Canvas x:Name="RegionTimelineCanvas" Margin="12,1,12,1" IsHitTestVisible="False" />
                            <Slider x:Name="Timeline" Minimum="0" IsEnabled="False" ValueChanged="Timeline_ValueChanged" AutomationProperties.Name="Vị trí video editor" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClockText" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="00:00 / 00:00" />
                            <Button Grid.Column="1" x:Name="PlaybackButton" AccessKey="P" Click="Playback_Click" Content="Phát video" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="2" x:Name="FullscreenButton" AccessKey="F" Click="Fullscreen_Click" Content="Toàn màn hình" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="3" x:Name="RefreshFrameButton" Click="Refresh_Click" Content="Làm mới hiệu ứng" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="InspectorScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="7">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Nguồn và project" />
                                    <Border HorizontalAlignment="Right" Padding="8,3" Background="{ThemeResource RaisedSurfaceBrush}" CornerRadius="9"><TextBlock FontSize="10" Foreground="{ThemeResource SecondaryTextBrush}" Text="Tự lưu" /></Border>
                                </Grid>
                                <TextBlock x:Name="PathText" Style="{StaticResource MutedTextStyle}" Text="Chưa chọn video." TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaText" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="9">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Vùng đang chọn" />
                                    <Border HorizontalAlignment="Right" Padding="8,3" Background="{ThemeResource AccentSoftBrush}" CornerRadius="9"><TextBlock FontSize="10" Foreground="{ThemeResource AccentPrimaryBrush}" Text="Chỉnh trực tiếp" /></Border>
                                </Grid>
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Kéo ngoài vùng để tạo mới; kéo giữa để di chuyển; kéo mép/góc để resize. Các ô số dùng khi cần chính xác." />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="RegionXBox" Header="X (%)" Minimum="0" Maximum="100" SmallChange="1" ValueChanged="RegionCoordinates_ValueChanged" />
                                    <NumberBox Grid.Column="1" x:Name="RegionYBox" Header="Y (%)" Minimum="0" Maximum="100" SmallChange="1" ValueChanged="RegionCoordinates_ValueChanged" />
                                    <NumberBox Grid.Column="2" x:Name="RegionWidthBox" Header="Rộng (%)" Minimum="0" Maximum="100" SmallChange="1" ValueChanged="RegionCoordinates_ValueChanged" />
                                    <NumberBox Grid.Column="3" x:Name="RegionHeightBox" Header="Cao (%)" Minimum="0" Maximum="100" SmallChange="1" ValueChanged="RegionCoordinates_ValueChanged" />
                                </Grid>
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="EffectBox" Header="Hiệu ứng" SelectedIndex="0" SelectionChanged="EffectBox_SelectionChanged">
                                        <ComboBoxItem Tag="blur" Content="Làm mờ" />
                                        <ComboBoxItem Tag="mosaic" Content="Mosaic" />
                                        <ComboBoxItem Tag="cover" Content="Che đen" />
                                    </ComboBox>
                                    <NumberBox Grid.Column="1" x:Name="StrengthBox" Header="Cường độ" Minimum="2" Maximum="64" Value="18" ValueChanged="EditInput_ValueChanged" />
                                </Grid>
                                <ToggleSwitch x:Name="WholeToggle" Header="Áp dụng toàn video" IsOn="True" Toggled="WholeToggle_Toggled" />
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="StartBox" Header="Bắt đầu (s)" IsEnabled="False" ValueChanged="EditInput_ValueChanged" />
                                    <NumberBox Grid.Column="1" x:Name="EndBox" Header="Kết thúc (s)" IsEnabled="False" ValueChanged="EditInput_ValueChanged" />
                                </Grid>
                                <TextBlock x:Name="RegionValidationText" Style="{StaticResource MutedTextStyle}" Text="Chọn video rồi kéo để tạo vùng." AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="AddRegionButton" Click="AddRegion_Click" Content="Thêm bằng tọa độ hiện tại" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Danh sách vùng" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="UndoButton" Click="Undo_Click" Content="Hoàn tác" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="RedoButton" Click="Redo_Click" Content="Làm lại" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="SubtitlePresetButton" Click="SubtitlePreset_Click" Content="Vùng phụ đề dưới" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="WatermarkPresetButton" Click="WatermarkPreset_Click" Content="Watermark góc phải" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                                <ListView x:Name="RegionList" Height="130" SelectionChanged="RegionList_SelectionChanged" AutomationProperties.Name="Danh sách vùng hiệu ứng" />
                                <Button x:Name="RemoveRegionButton" Click="RemoveRegion_Click" Content="Xóa vùng chọn" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Xuất video" />
                                    <Border HorizontalAlignment="Right" Padding="8,3" Background="{ThemeResource SuccessSoftBrush}" CornerRadius="9"><TextBlock FontSize="10" Foreground="{ThemeResource SuccessBrush}" Text="Không ghi đè nguồn" /></Border>
                                </Grid>
                                <TextBox x:Name="FileNameBox" Header="Tên file đầu ra" PlaceholderText="video_edited.mp4" TextChanged="FileNameBox_TextChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="RenderButton" Click="Render_Click" Content="Xuất video" IsEnabled="False" />
                                    <Button x:Name="CancelButton" Click="Cancel_Click" Content="Hủy" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" AutomationProperties.Name="Tiến độ xuất video" />
                                <Border Padding="10,8" Background="{ThemeResource SuccessSoftBrush}" CornerRadius="8">
                                    <TextBlock x:Name="StatusText" FontSize="11" Foreground="{ThemeResource SuccessBrush}" Text="Sẵn sàng." AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" Padding="12,8" Background="{ThemeResource RaisedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Project vùng được tự lưu trong Data/Projects. Hủy xuất chỉ hoàn tất sau khi cây FFmpeg đã dừng và file render dở được xóa." />
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
