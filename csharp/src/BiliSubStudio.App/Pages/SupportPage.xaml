<Page
    x:Class="BiliSubStudio.App.Pages.SupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Cập nhật và hỗ trợ">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageRoot" Padding="28" MaxWidth="980" HorizontalAlignment="Left" SizeChanged="Page_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Cập nhật &amp; hỗ trợ" />
                <TextBlock Style="{StaticResource BodyTextStyle}" Text="Updater xác minh SHA-256 và chỉ nhận payload winui3-portable-zip; báo lỗi tự che cookie/token/đường dẫn người dùng." />
            </StackPanel>
            <Grid x:Name="SupportGrid" Grid.Row="1" Margin="0,22,0,0" ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Cập nhật" />
                        <TextBlock x:Name="UpdateText" Style="{StaticResource BodyTextStyle}" Text="Chưa kiểm tra." AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckButton" AccessKey="U" Click="CheckUpdate_Click" Content="Kiểm tra" />
                            <Button x:Name="PrepareButton" Click="PrepareUpdate_Click" Content="Tải và chuẩn bị" IsEnabled="False" />
                        </StackPanel>
                        <ProgressBar x:Name="UpdateProgress" AutomationProperties.Name="Tiến độ kiểm tra hoặc chuẩn bị cập nhật" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Nếu kênh Drive vẫn là candidate Go, ứng dụng sẽ từ chối tải." />
                    </StackPanel>
                </Border>
                <Border x:Name="ReportCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Gửi báo lỗi" />
                        <ComboBox x:Name="PageBox" Header="Module" SelectedIndex="0">
                            <x:String>General</x:String><x:String>Video</x:String><x:String>Subtitle</x:String><x:String>OCR</x:String><x:String>Editor</x:String><x:String>Hardware</x:String><x:String>Account</x:String><x:String>Settings</x:String><x:String>Support</x:String>
                        </ComboBox>
                        <TextBox x:Name="NoteBox" Header="Mô tả" AcceptsReturn="True" MinHeight="150" TextWrapping="Wrap" TextChanged="NoteBox_TextChanged" AutomationProperties.Name="Mô tả lỗi" />
                        <Button x:Name="SendButton" Click="SendReport_Click" Content="Gửi báo lỗi đã sanitize" IsEnabled="False" />
                        <TextBlock x:Name="ReportStatus" Style="{StaticResource MutedTextStyle}" Text="Mô tả ngắn lỗi và thao tác gây lỗi." AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
