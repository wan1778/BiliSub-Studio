<Page
    x:Class="BiliSubStudio.App.Pages.SupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource CanvasBrush}"
    AutomationProperties.Name="Cập nhật và hỗ trợ">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageRoot" Padding="0,0,0,28" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Cập nhật" />
                        <Border HorizontalAlignment="Right" Padding="9,4" Background="{ThemeResource SuccessSoftBrush}" CornerRadius="10">
                            <TextBlock FontSize="10" Foreground="{ThemeResource SuccessBrush}" Text="SHA-256 verified" />
                        </Border>
                    </Grid>
                    <Border Padding="12,10" Background="{ThemeResource RaisedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                        <TextBlock x:Name="UpdateText" Style="{StaticResource BodyTextStyle}" Text="Chưa kiểm tra." AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckButton" AccessKey="U" Click="CheckUpdate_Click" Content="Kiểm tra" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="PrepareButton" Click="PrepareUpdate_Click" Content="Tải và chuẩn bị" IsEnabled="False" />
                    </StackPanel>
                    <ProgressBar x:Name="UpdateProgress" AutomationProperties.Name="Tiến độ kiểm tra hoặc chuẩn bị cập nhật" />
                    <Border Padding="11,8" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBlock FontSize="11" Foreground="{ThemeResource AccentPrimaryBrush}" Text="Chỉ nhận gói cập nhật chính thức từ GitHub Releases và phải khớp kích thước/SHA-256." TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="ReportCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Gửi báo lỗi" />
                        <Border HorizontalAlignment="Right" Padding="9,4" Background="{ThemeResource WarningSoftBrush}" CornerRadius="10">
                            <TextBlock FontSize="10" Foreground="{ThemeResource WarningBrush}" Text="Kèm log chung" />
                        </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Báo lỗi sẽ kèm tối đa 500 dòng Nhật ký toàn ứng dụng và job đang hoạt động; dữ liệu được sanitize trước khi gửi." />
                    <ComboBox x:Name="PageBox" Header="Module" SelectedIndex="0">
                        <x:String>General</x:String><x:String>Video</x:String><x:String>Subtitle</x:String><x:String>OCR</x:String><x:String>Editor</x:String><x:String>Hardware</x:String><x:String>Account</x:String><x:String>Settings</x:String><x:String>Support</x:String>
                    </ComboBox>
                    <TextBox x:Name="NoteBox" Header="Mô tả" AcceptsReturn="True" MinHeight="130" TextWrapping="Wrap" TextChanged="NoteBox_TextChanged" AutomationProperties.Name="Mô tả lỗi" />
                    <Button x:Name="SendButton" HorizontalAlignment="Left" Click="SendReport_Click" Content="Gửi báo lỗi đã sanitize" IsEnabled="False" />
                    <Border Padding="11,8" Background="{ThemeResource SuccessSoftBrush}" BorderBrush="{ThemeResource SuccessBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBlock x:Name="ReportStatus" FontSize="11" Foreground="{ThemeResource SuccessBrush}" Text="Mô tả ngắn lỗi và thao tác gây lỗi." AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
