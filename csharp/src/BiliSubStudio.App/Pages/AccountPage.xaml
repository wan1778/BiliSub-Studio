<Page
    x:Class="BiliSubStudio.App.Pages.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Đăng nhập Bilibili">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageRoot" Padding="28" MaxWidth="980" HorizontalAlignment="Left">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Đăng nhập Bilibili" />
                <TextBlock Style="{StaticResource BodyTextStyle}" Text="QR render native trong WinUI; cookie mã hóa bằng Windows DPAPI trong Data/session.bin." />
            </StackPanel>
            <Grid x:Name="ContentGrid" Grid.Row="1" Margin="0,22,0,0" ColumnSpacing="16" RowSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <Canvas x:Name="QrCanvas" Width="260" Height="260" Background="White" AutomationProperties.Name="Mã QR đăng nhập Bilibili" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button x:Name="QrButton" AccessKey="Q" Click="Qr_Click" Content="Tạo mã QR" />
                            <ProgressRing x:Name="QrProgress" Width="22" Height="22" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Đang chờ đăng nhập QR" />
                        </StackPanel>
                        <TextBlock x:Name="QrStatusText" MaxWidth="270" TextAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="Mở Bilibili trên điện thoại để quét." AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="AccountInspector" Grid.Column="1" Spacing="14">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Trạng thái" />
                            <TextBlock x:Name="LoginStatusText" Style="{StaticResource BodyTextStyle}" Text="Đang kiểm tra..." AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ValidateButton" Click="Validate_Click" Content="Kiểm tra lại" />
                                <Button x:Name="DeleteButton" Click="Delete_Click" Content="Đăng xuất / xóa cookie" Style="{StaticResource DangerButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Nhập cookie thủ công" />
                            <PasswordBox x:Name="CookieBox" PlaceholderText="SESSDATA hoặc chuỗi Cookie" PasswordChanged="CookieBox_PasswordChanged" AutomationProperties.Name="Cookie Bilibili" />
                            <Button x:Name="SaveCookieButton" Click="SaveCookie_Click" Content="Xác minh và lưu DPAPI" IsEnabled="False" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="Cookie chỉ ghi sau khi endpoint nav xác nhận đăng nhập hợp lệ." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
