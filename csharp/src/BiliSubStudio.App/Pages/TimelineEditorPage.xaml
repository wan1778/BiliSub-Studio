<Page
    x:Class="BiliSubStudio.App.Pages.TimelineEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource CanvasBrush}"
    AutomationProperties.Name="Timeline">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Timeline" />
            <TextBlock x:Name="ShellStatusText" TextWrapping="Wrap"
                       Text="V2 shell chưa có dữ liệu. Tạo project thử nghiệm trong test root tách biệt." />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CreateTestProjectButton" Click="CreateTestProject_Click" Content="Tạo project thử nghiệm" />
                <Button x:Name="RefreshListButton" Click="RefreshList_Click" Content="Làm mới" />
            </StackPanel>
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Copy project classic sang V2 (G11 readiness)" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Chỉ copy: project schema-7 và media nguồn không bao giờ bị sửa. Cần backup production đã ghi nhận trước khi copy. Bản classic vẫn mở bình thường ở tab Chỉnh video." />
            <ComboBox x:Name="ClassicProjectCombo" MinWidth="420" PlaceholderText="Chọn project classic (schema 7)" />
            <TextBox x:Name="BackupTagBox" MinWidth="420" PlaceholderText="Backup tag, ví dụ Projects-G0-20260906T162516Z" />
            <TextBox x:Name="BackupManifestBox" MinWidth="420" PlaceholderText="SHA-256 manifest của bản backup (64 ký tự hex)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CopyClassicProjectButton" Click="CopyClassicProject_Click" Content="Copy sang V2" />
                <Button x:Name="RefreshClassicButton" Click="RefreshClassic_Click" Content="Nạp danh sách classic" />
            </StackPanel>
            <TextBlock x:Name="PromotionStatusText" TextWrapping="Wrap" Text="" />
            <TextBlock x:Name="RootText" FontSize="11" TextWrapping="Wrap" Opacity="0.7" Text="Test root: chưa khởi tạo." />
            <ListView x:Name="ProjectList" SelectionMode="Single" IsItemClickEnabled="False" MaxHeight="320"
                      SelectionChanged="ProjectList_SelectionChanged" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ExportProjectButton" Click="ExportProject_Click" Content="Xuất project đã chọn" />
            </StackPanel>
            <TextBlock x:Name="ExportStatusText" TextWrapping="Wrap" Text="" />
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Processed preview toàn timeline" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Preview dùng đúng render plan hiện tại, kể cả thay đổi chưa lưu. Dừng preview trước khi tiếp tục chỉnh sửa." />
            <Border BorderBrush="#34465E" BorderThickness="1" CornerRadius="8" Background="#080C12">
                <Grid Height="300">
                    <MediaPlayerElement x:Name="TimelinePreviewPlayer"
                                        AreTransportControlsEnabled="False" AutoPlay="False"
                                        Stretch="Uniform" Visibility="Collapsed"
                                        AutomationProperties.Name="Processed preview Timeline" />
                    <TextBlock x:Name="TimelinePreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Bản xem trước sẽ xuất hiện ở đây" Opacity="0.65" />
                    <ProgressRing x:Name="TimelinePreviewProgress" Width="42" Height="42"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsActive="False" Visibility="Collapsed" />
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="TimelinePreviewPlayButton" Click="TimelinePreviewPlay_Click"
                        Content="Tạo và phát preview" />
                <Button x:Name="TimelinePreviewPauseButton" Click="TimelinePreviewPause_Click"
                        Content="Tạm dừng" IsEnabled="False" />
                <Button x:Name="TimelinePreviewStopButton" Click="TimelinePreviewStop_Click"
                        Content="Dừng" IsEnabled="False" />
                <TextBlock x:Name="TimelinePreviewClockText" VerticalAlignment="Center" Text="00:00 / 00:00" />
            </StackPanel>
            <TextBlock x:Name="TimelinePreviewStatusText" TextWrapping="Wrap" Opacity="0.8"
                       AutomationProperties.LiveSetting="Polite"
                       Text="Mở project có sequence để tạo preview." />
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Timeline trực tiếp" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Kéo thân clip để đổi thứ tự. Chọn clip rồi kéo mép trái/phải để trim; trên màn hình cảm ứng, kéo vùng KÉO hoặc vuốt phần còn lại để cuộn." />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock VerticalAlignment="Center" Text="Thu phóng" />
                <Slider x:Name="TimelineZoomSlider" Width="260"
                        Minimum="1" Maximum="320" Value="80" StepFrequency="1" />
                <TextBlock x:Name="TimelineZoomText" VerticalAlignment="Center" Text="80 px/s" />
            </StackPanel>
            <Border BorderBrush="#34465E" BorderThickness="1" CornerRadius="8" Background="#151D29">
                <ScrollViewer x:Name="TimelineScroller" Height="124"
                              HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                    <Canvas x:Name="TimelineSurface" Width="700" Height="104" Background="Transparent"
                            AutomationProperties.AccessibilityView="Raw"
                            PointerPressed="TimelineSurface_PointerPressed"
                            PointerMoved="TimelineSurface_PointerMoved"
                            PointerReleased="TimelineSurface_PointerReleased"
                            PointerCanceled="TimelineSurface_PointerCanceled"
                            PointerCaptureLost="TimelineSurface_PointerCaptureLost" />
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="TimelineDragStatusText" FontSize="12" TextWrapping="Wrap" Opacity="0.8"
                       AutomationProperties.LiveSetting="Polite"
                       Text="Mở project có sequence để thao tác trực tiếp." />
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Sửa clip chính xác (thời gian nhập bằng giây)" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Chọn project V2 trong danh sách rồi chọn clip. Mọi thao tác đều undo được và chỉ lưu khi bấm Lưu." />
            <ListView x:Name="ClipList" SelectionMode="Single" IsItemClickEnabled="False" MaxHeight="200"
                      SelectionChanged="ClipList_SelectionChanged" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="TrimInBox" MinWidth="140" PlaceholderText="SourceIn (s)" />
                <TextBox x:Name="TrimOutBox" MinWidth="140" PlaceholderText="SourceOut (s)" />
                <Button x:Name="TrimClipButton" Click="TrimClip_Click" Content="Trim" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="SplitAtBox" MinWidth="140" PlaceholderText="Cắt tại (s, sequence)" />
                <Button x:Name="SplitClipButton" Click="SplitClip_Click" Content="Split" />
                <Button x:Name="MoveUpButton" Click="MoveUp_Click" Content="Lên" />
                <Button x:Name="MoveDownButton" Click="MoveDown_Click" Content="Xuống" />
                <Button x:Name="DeleteClipButton" Click="DeleteClip_Click" Content="Xóa clip" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="UndoButton" Click="Undo_Click" Content="Undo" />
                <Button x:Name="RedoButton" Click="Redo_Click" Content="Redo" />
                <Button x:Name="SaveProjectButton" Click="SaveProject_Click" Content="Lưu" />
                <Button x:Name="RelinkMediaButton" Click="RelinkMedia_Click" Content="Nối lại nguồn" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="TimelineAutosaveText" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                       Text="Tự động lưu: chưa có project." />
            <TextBlock x:Name="EditStatusText" TextWrapping="Wrap" Text="" />
        </StackPanel>
    </ScrollViewer>
</Page>
