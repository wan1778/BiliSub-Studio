<Page
    x:Class="BiliSubStudio.App.Pages.TimelineEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource CanvasBrush}"
    AutomationProperties.Name="Timeline">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="12,10,12,8" Background="#0D1219">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Timeline" VerticalAlignment="Center" />
                <ComboBox x:Name="ProjectList" MinWidth="260" MaxWidth="420"
                          SelectionChanged="ProjectList_SelectionChanged" />
                <Button x:Name="RefreshListButton" Click="RefreshList_Click" Content="Làm mới"
                        VerticalAlignment="Center" Margin="8,0,0,0" />
                <Button x:Name="RelinkMediaButton" Click="RelinkMedia_Click" Content="Nối lại nguồn" IsEnabled="False"
                        VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Click="Undo_Click" Content="Undo" IsEnabled="False" />
                <Button x:Name="RedoButton" Click="Redo_Click" Content="Redo" IsEnabled="False" />
                <Button x:Name="SaveProjectButton" Click="SaveProject_Click" Content="Lưu"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="ExportProjectButton" Click="ExportProject_Click" Content="Xuất" />
            </StackPanel>
            <!-- Hidden compatibility fields referenced by code-behind -->
            <TextBlock x:Name="ShellStatusText" Visibility="Collapsed" Text="" />
        </Grid>

        <!-- Middle: preview + inspector -->
        <Grid Grid.Row="1" Padding="12,8,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Border BorderBrush="#34465E" BorderThickness="1" CornerRadius="8" Background="#080C12">
                    <Grid>
                        <MediaPlayerElement x:Name="TimelinePreviewPlayer"
                                            AreTransportControlsEnabled="False" AutoPlay="False"
                                            Stretch="Uniform" Visibility="Collapsed"
                                            AutomationProperties.Name="Processed preview Timeline" />
                        <TextBlock x:Name="TimelinePreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Bản xem trước sẽ xuất hiện ở đây" Opacity="0.65" TextWrapping="Wrap" />
                        <ProgressRing x:Name="TimelinePreviewProgress" Width="42" Height="42"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsActive="False" Visibility="Collapsed" />

                        <!-- Empty-state overlay -->
                        <Border x:Name="EmptyStatePanel" Padding="28" CornerRadius="8"
                                BorderBrush="#34465E" BorderThickness="1" Background="#0F1622"
                                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <StackPanel Spacing="12">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Đây là Timeline V2 (sandbox)" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.85"
                                           Text="Chạy trong test root tách biệt, không đụng dữ liệu production. Chọn một project bên trên hoặc tạo mới để bắt đầu." />
                                <Button x:Name="CreateTestProjectButton" Click="CreateTestProject_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="Tạo project thử nghiệm"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Inspector -->
            <ScrollViewer Grid.Column="1" Width="272" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Padding="2">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Inspector" />
                    <TextBlock x:Name="InspectorClipLabel" TextWrapping="Wrap" Opacity="0.85"
                               Text="Chưa chọn clip." />
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Danh sách clip" Margin="0,6,0,0" />
                    <ListView x:Name="ClipList" SelectionMode="Single" IsItemClickEnabled="False" MaxHeight="140"
                              SelectionChanged="ClipList_SelectionChanged" />
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Trim (giây)" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="TrimInBox" Width="100" PlaceholderText="In (s)" />
                        <TextBox x:Name="TrimOutBox" Width="100" PlaceholderText="Out (s)" />
                        <Button x:Name="TrimClipButton" Click="TrimClip_Click" Content="Trim" />
                    </StackPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Split / di chuyển" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="SplitAtBox" Width="110" PlaceholderText="Cắt tại (s)" />
                        <Button x:Name="SplitClipButton" Click="SplitClip_Click" Content="Split" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="MoveUpButton" Click="MoveUp_Click" Content="Lên" />
                        <Button x:Name="MoveDownButton" Click="MoveDown_Click" Content="Xuống" />
                        <Button x:Name="DeleteClipButton" Click="DeleteClip_Click" Content="Xóa clip" />
                    </StackPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Trạng thái" Margin="0,6,0,0" />
                    <TextBlock x:Name="EditStatusText" TextWrapping="Wrap" Opacity="0.85" />
                    <TextBlock x:Name="TimelineAutosaveText" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               Text="Tự động lưu: chưa có project." />
                    <TextBlock x:Name="ExportStatusText" TextWrapping="Wrap" Opacity="0.85" />
                    <TextBlock x:Name="PromotionStatusText" TextWrapping="Wrap" Opacity="0.85" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Timeline track + preview transport -->
        <Grid Grid.Row="2" Padding="12,6,12,12" RowSpacing="8" Background="#0D1219">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                <Button x:Name="TimelinePreviewPlayButton" Click="TimelinePreviewPlay_Click"
                        Content="Tạo và phát preview" />
                <Button x:Name="TimelinePreviewPauseButton" Click="TimelinePreviewPause_Click"
                        Content="Tạm dừng" IsEnabled="False" />
                <Button x:Name="TimelinePreviewStopButton" Click="TimelinePreviewStop_Click"
                        Content="Dừng" IsEnabled="False" />
                <TextBlock x:Name="TimelinePreviewClockText" VerticalAlignment="Center" Text="00:00 / 00:00" />
                <TextBlock x:Name="TimelinePreviewStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           MaxWidth="420" Opacity="0.85"
                           Text="Mở project có sequence để tạo preview." />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                <TextBlock VerticalAlignment="Center" Text="Thu phóng" />
                <Slider x:Name="TimelineZoomSlider" Width="240"
                        Minimum="1" Maximum="320" Value="80" StepFrequency="1" />
                <TextBlock x:Name="TimelineZoomText" VerticalAlignment="Center" Text="80 px/s" />
                <TextBlock x:Name="TimelineDragStatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           MaxWidth="420" Opacity="0.8"
                           Text="Mở project có sequence để thao tác trực tiếp." />
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="#34465E" BorderThickness="1" CornerRadius="8" Background="#151D29">
                <ScrollViewer x:Name="TimelineScroller" Height="176"
                              HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                    <Canvas x:Name="TimelineSurface" Width="700" Height="156" Background="Transparent"
                            AutomationProperties.AccessibilityView="Raw"
                            PointerPressed="TimelineSurface_PointerPressed"
                            PointerMoved="TimelineSurface_PointerMoved"
                            PointerReleased="TimelineSurface_PointerReleased"
                            PointerCanceled="TimelineSurface_PointerCanceled"
                            PointerCaptureLost="TimelineSurface_PointerCaptureLost" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer: optional classic promotion -->
        <Expander Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  x:Name="ClassicPromotionExpander" Header="Nâng cấp project classic sang V2 (tuỳ chọn)"
                  Margin="12,0,12,12">
            <StackPanel Spacing="8" Padding="4">
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="Chỉ copy: project schema-7 và media nguồn không bao giờ bị sửa. Cần backup production đã ghi nhận trước khi copy. Bản classic vẫn mở bình thường ở tab Chỉnh video." />
                <ComboBox x:Name="ClassicProjectCombo" MinWidth="420" HorizontalAlignment="Left"
                          PlaceholderText="Chọn project classic (schema 7)" />
                <TextBox x:Name="BackupTagBox" MinWidth="420" HorizontalAlignment="Left"
                         PlaceholderText="Backup tag, ví dụ Projects-G0-20260906T162516Z" />
                <TextBox x:Name="BackupManifestBox" MinWidth="420" HorizontalAlignment="Left"
                         PlaceholderText="SHA-256 manifest của bản backup (64 ký tự hex)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CopyClassicProjectButton" Click="CopyClassicProject_Click" Content="Copy sang V2" />
                    <Button x:Name="RefreshClassicButton" Click="RefreshClassic_Click" Content="Nạp danh sách classic" />
                </StackPanel>
                <TextBlock x:Name="RootText" FontSize="11" TextWrapping="Wrap" Opacity="0.7"
                           Text="Test root: chưa khởi tạo." />
            </StackPanel>
        </Expander>
    </Grid>
</Page>
