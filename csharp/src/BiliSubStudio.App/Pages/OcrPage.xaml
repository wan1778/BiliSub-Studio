<Page
    x:Class="BiliSubStudio.App.Pages.OcrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
    Background="{ThemeResource CanvasBrush}"
    AutomationProperties.Name="OCR phụ đề cứng">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageRoot" Padding="24,18,24,28" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock FontSize="10" Foreground="{ThemeResource MutedTextBrush}" Text="BiliSub Studio / OCR phụ đề" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="OCR phụ đề cứng" />
                        <Border Margin="0,5,0,0" Padding="9,4" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="11">
                            <TextBlock FontSize="10" Foreground="{ThemeResource AccentPrimaryBrush}" Text="PP-OCRv6 Small" />
                        </Border>
                        <Border Margin="0,5,0,0" Padding="9,4" Background="{ThemeResource SuccessSoftBrush}" BorderBrush="{ThemeResource SuccessBrush}" BorderThickness="1" CornerRadius="11">
                            <TextBlock FontSize="10" Foreground="{ThemeResource SuccessBrush}" Text="Checkpoint" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="CPU/GPU/Hybrid · topology 1–8/16 · checkpoint tự kiểm tra phiên bản" />
                </StackPanel>
                <Button
                    x:Name="PickVideoButton"
                    Grid.Column="1"
                    MinHeight="40"
                    Padding="18,8"
                    AccessKey="O"
                    Click="PickVideo_Click"
                    Background="{ThemeResource AccentPrimaryBrush}"
                    BorderBrush="{ThemeResource AccentPrimaryBrush}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    CornerRadius="8"
                    Content="Chọn video" />
            </Grid>

            <Grid x:Name="WorkspaceGrid" Grid.Row="1" Height="600" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>

                <Grid x:Name="PreviewPane" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="Black" BorderBrush="{ThemeResource StrongBorderBrush}" BorderThickness="1" CornerRadius="13">
                        <Grid x:Name="PreviewHost" AutomationProperties.Name="Khung xem trước video và vùng OCR">
                            <MediaPlayerElement x:Name="PreviewPlayer" AreTransportControlsEnabled="True" AutoPlay="False" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Trình phát video OCR" />
                            <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Frame xem trước bằng FFmpeg" />
                            <Canvas
                                x:Name="PreviewCanvas"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                PointerPressed="PreviewCanvas_PointerPressed"
                                PointerMoved="PreviewCanvas_PointerMoved"
                                PointerReleased="PreviewCanvas_PointerReleased"
                                AutomationProperties.Name="Vùng kéo chọn OCR">
                                <shapes:Rectangle
                                    x:Name="RoiRectangle"
                                    IsHitTestVisible="False"
                                    Stroke="#42CC96"
                                    StrokeThickness="2"
                                    Fill="#3042CC96" />
                            </Canvas>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Spacing="6">
                        <Slider x:Name="Timeline" Minimum="0" IsEnabled="False" ValueChanged="Timeline_ValueChanged" AutomationProperties.Name="Vị trí video OCR" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClockText" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="00:00 / 00:00" />
                            <Button Grid.Column="1" x:Name="PlaybackButton" AccessKey="P" Click="Playback_Click" Content="Phát video" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="2" x:Name="FullscreenButton" AccessKey="F" Click="Fullscreen_Click" Content="Toàn màn hình" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                            <ToggleSwitch Grid.Column="3" x:Name="SelectRegionButton" AccessKey="R" Toggled="SelectRegion_Toggled" OnContent="Đang chỉnh ROI" OffContent="Chỉnh ROI" IsEnabled="False" />
                            <Button Grid.Column="4" x:Name="RefreshFrameButton" Click="RefreshFrame_Click" Content="Cập nhật frame" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="InspectorScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="9">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Video" />
                                    <Border HorizontalAlignment="Right" Padding="8,3" Background="{ThemeResource RaisedSurfaceBrush}" CornerRadius="9"><TextBlock FontSize="10" Foreground="{ThemeResource SecondaryTextBrush}" Text="Nguồn" /></Border>
                                </Grid>
                                <TextBlock x:Name="PathText" Style="{StaticResource MutedTextStyle}" Text="Chưa chọn video." TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaText" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Engine và quét" />
                                    <Border HorizontalAlignment="Right" Padding="8,3" Background="{ThemeResource AccentSoftBrush}" CornerRadius="9"><TextBlock FontSize="10" Foreground="{ThemeResource AccentPrimaryBrush}" Text="Tự động dự đoán" /></Border>
                                </Grid>
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Bật Chỉnh ROI: kéo giữa để di chuyển, kéo mép/góc để đổi kích thước, kéo ngoài khung để tạo vùng mới." />
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DeviceBox" Header="Thiết bị" SelectedIndex="0"><x:String>auto</x:String><x:String>cpu</x:String><x:String>gpu</x:String><x:String>hybrid</x:String></ComboBox>
                                    <ComboBox Grid.Column="1" x:Name="ScanModeBox" Header="Chế độ" SelectedIndex="0">
                                        <ComboBoxItem Content="Cân bằng" Tag="balanced" />
                                        <ComboBoxItem Content="Chính xác" Tag="accurate" />
                                        <ComboBoxItem Content="Nhanh" Tag="fast" />
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" x:Name="LanesBox" Header="Luồng OCR" SelectedIndex="0"><x:String>auto</x:String><x:String>1</x:String><x:String>2</x:String><x:String>3</x:String><x:String>4</x:String><x:String>5</x:String><x:String>6</x:String><x:String>7</x:String><x:String>8</x:String><x:String>16</x:String></ComboBox>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Button x:Name="PrepareOcrButton" Click="Prepare_Click" Content="Chuẩn bị OCR" />
                                    <Button x:Name="TestFrameButton" Click="TestFrame_Click" Content="Test frame" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                                <Border Padding="10,8" Background="{ThemeResource AccentSoftBrush}" CornerRadius="8">
                                    <TextBlock x:Name="OcrResultText" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource AccentPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Quét toàn video" />
                                    <Border HorizontalAlignment="Right" Padding="8,3" Background="{ThemeResource SuccessSoftBrush}" CornerRadius="9"><TextBlock FontSize="10" Foreground="{ThemeResource SuccessBrush}" Text="Checkpoint an toàn" /></Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Button x:Name="ScanButton" Click="Scan_Click" Content="Quét / Tiếp tục" IsEnabled="False" />
                                    <Button x:Name="RestartButton" Click="Restart_Click" Content="Quét lại từ đầu" IsEnabled="True" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="PauseButton" Click="Pause_Click" Content="Tạm dừng" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="CancelButton" Click="Cancel_Click" Content="Hủy" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" AutomationProperties.Name="Tiến độ OCR" />
                                <Border Padding="10,8" Background="{ThemeResource SuccessSoftBrush}" CornerRadius="8">
                                    <TextBlock x:Name="StatusText" FontSize="11" Foreground="{ThemeResource SuccessBrush}" Text="Sẵn sàng." AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                                </Border>
                                <Button x:Name="ExportButton" Click="Export_Click" Content="Xuất SRT tiếng Trung" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="5">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Đo hiệu năng OCR" />
                        <TextBlock x:Name="TelemetryText" Style="{StaticResource MutedTextStyle}" Text="Chưa có telemetry." AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="1"
                    Height="372"
                    Padding="10"
                    Background="{ThemeResource RaisedSurfaceBrush}"
                    BorderBrush="{ThemeResource StrongBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    AutomationProperties.Name="Khung phụ đề OCR đã quét">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock FontSize="12" VerticalAlignment="Center" Text="Phụ đề OCR đã quét · 10 câu mỗi lượt xem" />
                            <TextBlock x:Name="CueCountText" Grid.Column="1" FontSize="11" VerticalAlignment="Center" Text="0 câu" />
                        </Grid>
                        <ListView
                            x:Name="CueList"
                            Grid.Row="1"
                            Padding="0"
                            SelectionChanged="CueList_SelectionChanged"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            AutomationProperties.Name="Danh sách câu phụ đề OCR">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{Binding}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
