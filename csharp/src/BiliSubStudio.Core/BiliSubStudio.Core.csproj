<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BiliSubStudio.Core</RootNamespace>
    <AssemblyName>BiliSubStudio.Core</AssemblyName>
    <!-- Sản phẩm Windows-only (publish win-x64): tắt cảnh báo platform cho
         System.Drawing (đo luminance/hash). Mọi đường GDI+ đều có
         OperatingSystem.IsWindows() + fail-open, không bao giờ throw ra lane. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Giải mã JPEG trong-process cho đo luminance/hash (Windows-only, app win-x64).
         Không dùng Bitmap với vùng — chỉ LockBits đọc pixel, using nghiêm + test rõ handle. -->
    <PackageReference Include="System.Drawing.Common" />
    <!-- Browser session import reads the local Chrome/Edge/Firefox cookie
         store (the same source yt-dlp's cookies-from-browser option uses). -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <!-- ContractTests kiểm trực tiếp API nội bộ (planner/validator nội bộ):
         mở internals cho assembly test, không nới public API. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>BiliSubStudio.Core.ContractTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
